#!/bin/bash
# Toolbox instance bootstrap -- installs the idle auto-terminate timer, then the
# same tool list the dfe-toolbox-aws container image carries, at the SAME
# versions.yaml pins (every substitution below is a render_dial.py-supplied
# value, and nothing here is a literal version).
#
# Every download is checked against an anchor this module pins before it
# installs, and a failed check stops the boot. Each install site names its anchor.
#
# AL2023 ships the SSM Agent preinstalled (AWS's own agent-install-al2.html:
# "AMIs for Amazon Linux 2 and Amazon Linux 2023 ... come with SSM Agent
# preinstalled by default"), so nothing here installs or starts it.
set -euo pipefail

ARCH=arm64
# The RPM/dnf spelling of the same architecture, which the AWS CLI download is
# named with. Every other download here uses the Debian/Docker one.
RPM_ARCH=aarch64
BIN=/usr/local/bin
mkdir -p "$BIN"

# ---------------------------------------------------------------------------
# Idle auto-terminate -- see CONTRACT.md #9. FIRST, before anything that can
# fail: this is the only thing bounding an idle instance's cost, and under
# `set -e` a failed install further down would otherwise leave the box running
# with no timer on it. No IAM grant of any kind: the instance was launched with
# instance_initiated_shutdown_behavior = terminate, so `shutdown -h now` on THIS
# instance IS the teardown, and detecting "idle" by counting local
# ssm-session-worker processes needs no API call either (ssm:DescribeSessions is
# unscoped -- Resource: "*" -- and this avoids granting it at all).
# ---------------------------------------------------------------------------
cat > /usr/local/sbin/toolbox-idle-check.sh <<'SCRIPT'
#!/bin/bash
# Exit 0 (idle) when no ssm-session-worker process has run for TTL_MINUTES.
# The SSM Agent forks one such process per active session -- shell AND
# port-forward alike -- so this sees the session type nothing else in this
# module observes (a forward carries no transcript to check instead).
set -euo pipefail
STATE=/var/run/toolbox-idle-since
TTL_SECONDS=$(( ${ttl_minutes} * 60 ))

if pgrep -f ssm-session-worker >/dev/null 2>&1; then
  rm -f "$STATE"
  exit 0
fi

NOW=$(date +%s)
if [ ! -f "$STATE" ]; then
  echo "$NOW" > "$STATE"
  exit 0
fi

IDLE_SINCE=$(cat "$STATE")
if (( NOW - IDLE_SINCE >= TTL_SECONDS )); then
  logger -t toolbox-idle-check "no active SSM session for $TTL_SECONDS seconds -- shutting down"
  shutdown -h now
fi
SCRIPT
chmod +x /usr/local/sbin/toolbox-idle-check.sh

cat > /etc/systemd/system/toolbox-idle-check.service <<'UNIT'
[Unit]
Description=Terminate this toolbox instance once no SSM session has been active for ttl_minutes

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/toolbox-idle-check.sh
UNIT

cat > /etc/systemd/system/toolbox-idle-check.timer <<'UNIT'
[Unit]
Description=Run toolbox-idle-check every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now toolbox-idle-check.timer

# --- Download checks: each helper stops the boot when its check fails.

# HTTPS only, failing on an HTTP error, and bounded so a stalled download fails the boot.
fetch() {
  curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 30 --max-time 900 --retry 3 -o "$1" "$2"
}

# AL2023's gnupg2-minimal ships no gpg-agent, and public-key work needs none.
pgp() {
  gpg --homedir "$1" --batch --no-autostart --quiet "$${@:2}"
}

# Writes $3 holding only the key whose primary fingerprint is $2, taken from the key file $1.
pinned_key() {
  local home found
  home="$(mktemp -d)"
  pgp "$home" --import "$1"
  pgp "$home" --armor --export "$2" > "$3"
  if [ ! -s "$3" ]; then
    echo "toolbox-bootstrap: $1 holds no key $2" >&2
    exit 1
  fi
  found="$(pgp "$home" --with-colons --show-keys "$3" | awk -F: '$1 == "pub" { want = 1; next } want && $1 == "fpr" { print $10; want = 0 }')"
  rm -rf "$home"
  if [ "$found" != "$2" ]; then
    echo "toolbox-bootstrap: $1 gave primary key $found, not $2" >&2
    exit 1
  fi
}

# Fails unless $3 is a good signature over $4 by the key with primary fingerprint $2, held alone in $1.
verify_signature() {
  local home status
  home="$(mktemp -d)"
  pgp "$home" --import "$1"
  if ! status="$(pgp "$home" --status-fd 1 --verify "$3" "$4")"; then
    echo "toolbox-bootstrap: no good signature on $4" >&2
    exit 1
  fi
  rm -rf "$home"
  case "$status" in
    *"VALIDSIG "*" $2"*) ;;
    *)
      echo "toolbox-bootstrap: $4 is not signed by $2" >&2
      exit 1
      ;;
  esac
}

# Fails unless the file $1 hashes to the SHA256 $2.
verify_sha256() {
  echo "$2  $1" | sha256sum --check --strict -
}

# Trusts the repo key at $2 for dnf and rpm only once it proves to be the key with primary fingerprint $3.
repo_key() {
  fetch "/tmp/$1.key" "$2"
  pinned_key "/tmp/$1.key" "$3" "/etc/pki/rpm-gpg/RPM-GPG-KEY-$1"
  rpm --import "/etc/pki/rpm-gpg/RPM-GPG-KEY-$1"
  rm -f "/tmp/$1.key"
}

# --- jq, openssl, unzip: AL2023's own repos, signed by the Amazon Linux key the
# AMI carries, unpinned to match docker/dfe-toolbox/base/Dockerfile.
dnf install -y jq openssl unzip

# --- kubectl: pkgs.k8s.io's signed rpm repo, one per Kubernetes minor, key pinned by fingerprint.
# AL2023's dnf.conf skips a repo it cannot verify, so each vendor repo here refuses that instead.
KUBECTL_VERSION="${kubectl_version}"
KUBE_REPO="https://pkgs.k8s.io/core:/stable:/$${KUBECTL_VERSION%.*}/rpm/"
repo_key kubernetes "$${KUBE_REPO}repodata/repomd.xml.key" "${kubernetes_key_fpr}"
cat > /etc/yum.repos.d/kubernetes.repo <<REPO
[kubernetes]
name=Kubernetes
baseurl=$KUBE_REPO
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=False
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-kubernetes
REPO
dnf install -y "kubectl-$${KUBECTL_VERSION#v}"

# --- helm: the release tarball's signature, by the helm release key taken from
# KEYS at the release tag and pinned by fingerprint.
fetch /tmp/helm-KEYS "https://raw.githubusercontent.com/helm/helm/${helm_version}/KEYS"
pinned_key /tmp/helm-KEYS "${helm_key_fpr}" /tmp/helm-key.asc
fetch /tmp/helm.tar.gz "https://get.helm.sh/helm-${helm_version}-linux-$ARCH.tar.gz"
fetch /tmp/helm.tar.gz.asc "https://github.com/helm/helm/releases/download/${helm_version}/helm-${helm_version}-linux-$ARCH.tar.gz.asc"
verify_signature /tmp/helm-key.asc "${helm_key_fpr}" /tmp/helm.tar.gz.asc /tmp/helm.tar.gz
tar -xzf /tmp/helm.tar.gz -C /tmp
install -m 0755 "/tmp/linux-$ARCH/helm" "$BIN/helm"
rm -rf /tmp/helm-KEYS /tmp/helm-key.asc /tmp/helm.tar.gz /tmp/helm.tar.gz.asc "/tmp/linux-$ARCH"

# --- argocd CLI: the arm64 binary's SHA256, held in versions.yaml (toolbox.argocd-cli-arm64-sha256).
fetch /tmp/argocd "https://github.com/argoproj/argo-cd/releases/download/${argocd_version}/argocd-linux-$ARCH"
verify_sha256 /tmp/argocd "${argocd_sha256}"
install -m 0755 /tmp/argocd "$BIN/argocd"
rm -f /tmp/argocd

# --- OpenTofu: its signed rpm repo, packages signed by the OpenTofu key and the
# metadata by the repo key, both pinned by fingerprint.
repo_key opentofu https://get.opentofu.org/opentofu.gpg "${opentofu_key_fpr}"
repo_key opentofu-repo https://packages.opentofu.org/opentofu/tofu/gpgkey "${opentofu_repo_key_fpr}"
cat > /etc/yum.repos.d/opentofu.repo <<'REPO'
[opentofu]
name=OpenTofu
baseurl=https://packages.opentofu.org/opentofu/tofu/rpm_any/rpm_any/$basearch
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=False
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-opentofu file:///etc/pki/rpm-gpg/RPM-GPG-KEY-opentofu-repo
REPO
dnf install -y "tofu-${tofu_version}"

# --- yq: the arm64 binary's SHA256, held in versions.yaml (toolbox.yq-arm64-sha256).
fetch /tmp/yq "https://github.com/mikefarah/yq/releases/download/${yq_version}/yq_linux_$ARCH"
verify_sha256 /tmp/yq "${yq_sha256}"
install -m 0755 /tmp/yq "$BIN/yq"
rm -f /tmp/yq

# --- aws CLI v2: the zip's signature, by the AWS CLI Team key vendored as
# keys/aws-cli.asc and pinned by fingerprint.
cat > /tmp/aws-cli.key <<'KEY'
${awscli_key}
KEY
pinned_key /tmp/aws-cli.key "${awscli_key_fpr}" /tmp/aws-cli.asc
fetch /tmp/awscliv2.zip "https://awscli.amazonaws.com/awscli-exe-linux-$RPM_ARCH-${awscli_version}.zip"
fetch /tmp/awscliv2.zip.sig "https://awscli.amazonaws.com/awscli-exe-linux-$RPM_ARCH-${awscli_version}.zip.sig"
verify_signature /tmp/aws-cli.asc "${awscli_key_fpr}" /tmp/awscliv2.zip.sig /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install --update
rm -rf /tmp/aws-cli.key /tmp/aws-cli.asc /tmp/awscliv2.zip /tmp/awscliv2.zip.sig /tmp/aws

# --- session-manager-plugin: this version's rpm and its signature, by the AWS
# SSM key vendored as keys/session-manager-plugin.asc and pinned by fingerprint.
cat > /tmp/session-manager-plugin.key <<'KEY'
${ssm_plugin_key}
KEY
pinned_key /tmp/session-manager-plugin.key "${ssm_plugin_key_fpr}" /tmp/session-manager-plugin.asc
SSM_PLUGIN_URL="https://s3.amazonaws.com/session-manager-downloads/plugin/${ssm_plugin_version}/linux_$ARCH/session-manager-plugin.rpm"
fetch /tmp/session-manager-plugin.rpm "$SSM_PLUGIN_URL"
fetch /tmp/session-manager-plugin.rpm.sig "$SSM_PLUGIN_URL.sig"
verify_signature /tmp/session-manager-plugin.asc "${ssm_plugin_key_fpr}" /tmp/session-manager-plugin.rpm.sig /tmp/session-manager-plugin.rpm
dnf install -y /tmp/session-manager-plugin.rpm
rm -f /tmp/session-manager-plugin.key /tmp/session-manager-plugin.asc /tmp/session-manager-plugin.rpm /tmp/session-manager-plugin.rpm.sig
# The signed rpm at the versioned path must carry that version, or the boot stops.
[ "$(rpm -q --queryformat '%%{VERSION}' session-manager-plugin)" = "${ssm_plugin_version}" ]

# --- ClickHouse client, pinned to the SAME version this deployment's server
# runs (versions.yaml services.clickhouse-version), never a version of its own.
# ClickHouse's signed rpm repo, key pinned by fingerprint. The packages are
# unsigned, so the signed metadata holding each one's SHA256 is the check.
repo_key clickhouse https://packages.clickhouse.com/rpm/stable/repodata/repomd.xml.key "${clickhouse_key_fpr}"
cat > /etc/yum.repos.d/clickhouse.repo <<'REPO'
[clickhouse-stable]
name=ClickHouse stable
baseurl=https://packages.clickhouse.com/rpm/stable/
gpgcheck=0
repo_gpgcheck=1
skip_if_unavailable=False
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-clickhouse
REPO
# clickhouse-client requires clickhouse-common-static at no version, so both are named.
dnf install -y "clickhouse-common-static-${clickhouse_client_version}" "clickhouse-client-${clickhouse_client_version}"

# --- psql, pinned to the deployment's PostgreSQL MAJOR (services.postgresql),
# from AL2023's own repos, signed by the Amazon Linux key the AMI carries.
dnf install -y "postgresql${postgresql_major_version}"

# --- Java 17 -- the Apache Kafka CLI scripts below need it (KIP-1013: Kafka
# 4.0 raised brokers, Connect and the console tools to Java 17, and only clients
# and Streams stayed on 11). AL2023's own base repos, signed by the Amazon
# Linux key the AMI carries, ship Corretto 17.
dnf install -y java-17-amazon-corretto-headless

# --- Kafka CLI -- AL2023 has no kcat package, so this is Apache's own console
# scripts at services.kafka-version (the in-cluster broker's, which MSK may not be),
# from archive.apache.org, which keeps every release. Scala 2.13 is the only 4.x
# build. The tarball's signature, by that release's manager, whose key is taken
# from Apache's KEYS and pinned by fingerprint (toolbox.kafka-cli-signer).
KAFKA_URL="https://archive.apache.org/dist/kafka/${kafka_cli_version}/kafka_2.13-${kafka_cli_version}.tgz"
fetch /tmp/kafka-KEYS https://downloads.apache.org/kafka/KEYS
pinned_key /tmp/kafka-KEYS "${kafka_cli_signer_fpr}" /tmp/kafka-signer.asc
fetch /tmp/kafka-cli.tgz "$KAFKA_URL"
fetch /tmp/kafka-cli.tgz.asc "$KAFKA_URL.asc"
verify_signature /tmp/kafka-signer.asc "${kafka_cli_signer_fpr}" /tmp/kafka-cli.tgz.asc /tmp/kafka-cli.tgz
tar -xzf /tmp/kafka-cli.tgz -C /opt
ln -s "/opt/kafka_2.13-${kafka_cli_version}" /opt/kafka-cli
rm -f /tmp/kafka-KEYS /tmp/kafka-signer.asc /tmp/kafka-cli.tgz /tmp/kafka-cli.tgz.asc
# A plain symlink into $BIN would break these scripts: each one finds its own
# JARs via `dirname $0`, and a symlink's $0 is the LINK's path, never its
# target -- so a thin wrapper that execs the real script by absolute path is
# what keeps that lookup resolving inside /opt/kafka-cli, where the JARs
# actually live.
for tool in kafka-topics.sh kafka-console-producer.sh kafka-console-consumer.sh \
  kafka-consumer-groups.sh kafka-broker-api-versions.sh; do
  cat > "$BIN/$tool" <<WRAPPER
#!/bin/bash
exec /opt/kafka-cli/bin/$tool "\$@"
WRAPPER
  chmod +x "$BIN/$tool"
done
