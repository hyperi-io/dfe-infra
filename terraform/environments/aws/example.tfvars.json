{
  "provision": {
    "cloud": "aws",
    "account": "000000000000",
    "region": "us-west-2",
    "cidr": "10.90.0.0/16"
  },

  "name": "dfe-example",
  "env": "test",
  "profile": "scale",

  "kubernetes_version": "1.36",

  "node_pools": {
    "system": {
      "shape_ref": "eks-system",
      "min_size": 2,
      "max_size": 3,
      "desired_size": 2,
      "capacity_type": "ON_DEMAND",
      "disk_gb": 40,
      "labels": {},
      "taints": []
    }
  },

  "resolved_shapes": {
    "eks-system": {
      "instance_types": ["m9g.large", "m8g.large", "m7g.large"],
      "arch": "arm64"
    },
    "msk-broker": {
      "instance_types": ["express.m7g.large"],
      "arch": "arm64"
    }
  },

  "network": {
    "nat": "single",
    "az_count": 3
  },

  "endpoint": {
    "public": true,
    "allowed_cidrs": ["198.51.100.10/32"]
  },

  "dns": {
    "private_zone": "dfe-example.internal",
    "public_zone": ""
  },

  "telemetry": {
    "sink": "otel",
    "retention_days": 2
  },

  "storage_class": "gp3",

  "kafka": {
    "provider": "msk",
    "msk": {
      "shape_ref": "msk-broker",
      "broker_count": 3,
      "broker_version": "4.2.x.kraft",
      "num_partitions": 12,
      "log_retention_ms": 259200000,
      "message_max_bytes": 16777216,
      "scram_username": "dfe-kafka-user",
      "bootstrap_job": {
        "namespace": "strimzi",
        "service_account": "dfe-kafka-bootstrap"
      }
    }
  },

  "secrets": {
    "backend": "aws-sm",
    "ref": ""
  },

  "seeds": {
    "kafka/msk": { "password": "" },
    "ui/nextauth": { "secret": "" }
  },

  "endpoints": {
    "clickhouse_host": "dfe-clickhouse.clickhouse.svc.cluster.local",
    "kafka_bootstrap": "",
    "otel_endpoint": "otel-collector-gateway.otel.svc.cluster.local:4317"
  },

  "repo_url": "https://github.com/example/dfe-deploy.git",
  "target_revision": "main",

  "registry_host": "",
  "registry_user": "",
  "registry_token": "",

  "state": {
    "bucket": "example-s3-dfe-example-tfstate",
    "key": "dfe/test/aws.tfstate",
    "region": "us-west-2"
  },

  "toolbox": {
    "enabled": false,
    "aws": {
      "instance_type": "t4g.small",
      "operator_role_arn": ""
    },
    "ttl_minutes": 60,
    "session": {
      "idle_timeout_minutes": 15,
      "max_duration_minutes": 240
    },
    "session_log_retention_days": 90,
    "tool_versions": {}
  },

  "edge": {
    "enabled": true,
    "tunnel": {
      "address": {
        "mode": "byo",
        "instance_type": "t4g.small",
        "zone": ""
      },
      "openvpn": true,
      "source_ranges": [],
      "node_ports": {
        "wireguard": 31820,
        "openvpn": 31194
      }
    }
  },

  "tags": {
    "service-name": "dfe",
    "service-namespace": "example",
    "environment": "test",
    "owner": "owner@example.com",
    "cost-center": "experiments",
    "lifecycle": "throwaway",
    "iac-source": "dfe-infra/terraform/environments/aws"
  }
}
