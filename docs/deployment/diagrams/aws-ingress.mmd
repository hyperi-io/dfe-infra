---
config:
  theme: base
  look: classic
  fontFamily: Inter, Helvetica, Arial, sans-serif
  flowchart:
    curve: linear
    nodeSpacing: 28
    rankSpacing: 44
    padding: 14
    wrappingWidth: 280
    htmlLabels: true
  themeVariables:
    fontSize: 14px
    lineColor: "#545B64"
    primaryTextColor: "#000000"
    edgeLabelBackground: "#FFFFFF"
    clusterBkg: transparent
  themeCSS: >-
    .nodeLabel span{font-size:12px;color:#334155}
---
flowchart LR
  accTitle: L4 Detail -- DFE on AWS, ingress
  accDescr: Users reach the UIs through the gateway's internet-facing Network Load Balancer. Edge clients send events through the receiver's own NLB, which renders once senders are allowed, or the optional tunnel forwarder. All three sit in the public subnets, and the nodes and Amazon MSK brokers in the private subnets.
  users@{ icon: "aws:res-users", label: "Users", pos: "b", h: 48 }
  clients@{ icon: "aws:res-users", label: "Edge clients", pos: "b", h: 48 }
  subgraph cloud["AWS Cloud"]
    subgraph vpc["VPC"]
      subgraph pub["Public subnets"]
        gwnlb@{ icon: "aws:res-elastic-load-balancing-network-load-balancer", label: "Gateway NLB", pos: "b", h: 48 }
        nlb@{ icon: "aws:res-elastic-load-balancing-network-load-balancer", label: "Receiver NLB<br/>opt-in", pos: "b", h: 48 }
        fwd@{ icon: "aws:res-amazon-ec2-instance", label: "Tunnel forwarder", pos: "b", h: 48 }
      end
      subgraph priv["Private subnets"]
        nodes@{ icon: "aws:res-amazon-ec2-instances", label: "EKS nodes<br/>incl. Karpenter", pos: "b", h: 48 }
        msk@{ icon: "aws:amazon-managed-streaming-for-apache-kafka", label: "Amazon MSK<br/>if provider msk", pos: "b", h: 80 }
      end
    end
  end
  users -->|"UIs"| gwnlb
  clients -->|"events"| nlb
  clients -.->|"tunnel"| fwd
  gwnlb --> nodes
  nlb --> nodes
  fwd -.-> nodes
  nodes --> msk
  classDef ingest fill:#FFFFFF,stroke:#0E8A7D,stroke-width:3px,color:#0F172A
  classDef xform fill:#FFFFFF,stroke:#7B4FB0,stroke-width:3px,color:#0F172A
  classDef load fill:#FFFFFF,stroke:#0072B2,stroke-width:3px,color:#0F172A
  classDef bus fill:#FFFFFF,stroke:#A8517F,stroke-width:3px,color:#0F172A
  classDef store fill:#FFFFFF,stroke:#00785A,stroke-width:3px,color:#0F172A
  classDef ui fill:#FFFFFF,stroke:#D9480F,stroke-width:3px,color:#0F172A
  classDef ext fill:#F4F6F8,stroke:#94A3B8,stroke-width:1.5px,stroke-dasharray:5 4,color:#0F172A
  classDef decision fill:#FFFFFF,stroke:#9A6700,stroke-width:3px,color:#0F172A
  classDef error fill:#FFFFFF,stroke:#C2410C,stroke-width:3px,color:#0F172A
  classDef control fill:#FFFFFF,stroke:#334155,stroke-width:3px,color:#0F172A
  classDef part fill:#FFFFFF,stroke:#94A3B8,stroke-width:1.5px,color:#0F172A
  style cloud fill:none,stroke:#000000,stroke-width:1.5px,color:#000000
  style vpc fill:none,stroke:#8C4FFF,stroke-width:1.5px,color:#000000
  style pub fill:none,stroke:#7AA116,stroke-width:1.5px,color:#000000
  style priv fill:none,stroke:#00A4A6,stroke-width:1.5px,color:#000000
