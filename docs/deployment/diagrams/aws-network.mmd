---
config:
  theme: base
  look: classic
  fontFamily: Inter, Helvetica, Arial, sans-serif
  flowchart:
    curve: linear
    nodeSpacing: 28
    rankSpacing: 44
    padding: 14
    wrappingWidth: 280
    htmlLabels: true
  themeVariables:
    fontSize: 14px
    lineColor: "#545B64"
    primaryTextColor: "#000000"
    edgeLabelBackground: "#FFFFFF"
    clusterBkg: transparent
  themeCSS: >-
    .nodeLabel span{font-size:12px;color:#334155}
---
flowchart LR
  accTitle: L4 Detail -- DFE on AWS, network
  accDescr: Edge clients reach the cluster's nodes through the receiver's Network Load Balancer, or the optional tunnel forwarder, in the public subnets. The nodes and the Amazon MSK brokers sit in the private subnets. S3 traffic leaves through a gateway endpoint, and traffic for a managed Kafka outside AWS through the NAT gateway. The EKS control plane is AWS-managed, outside the VPC.
  clients@{ icon: "aws:res-users", label: "Edge clients", pos: "b", h: 48 }
  saas("<b>Confluent or Redpanda Cloud</b><br/><span>optional</span>")
  subgraph cloud["AWS Cloud"]
    subgraph region["Region"]
      eks@{ icon: "aws:amazon-elastic-kubernetes-service", label: "Amazon EKS<br/>control plane", pos: "b", h: 80 }
      s3@{ icon: "aws:amazon-simple-storage-service", label: "Amazon S3<br/>object store and logs", pos: "b", h: 80 }
      subgraph vpc["VPC"]
        s3ep@{ icon: "aws:res-amazon-vpc-endpoints", label: "S3 gateway endpoint", pos: "b", h: 48 }
        subgraph az["Availability Zones x az_count"]
          subgraph pub["Public subnets"]
            nlb@{ icon: "aws:res-elastic-load-balancing-network-load-balancer", label: "Receiver NLB<br/>made by the LB controller", pos: "b", h: 48 }
            fwd@{ icon: "aws:res-amazon-ec2-instance", label: "Tunnel forwarder<br/>optional", pos: "b", h: 48 }
            nat@{ icon: "aws:res-amazon-vpc-nat-gateway", label: "NAT gateway<br/>one or one per zone", pos: "b", h: 48 }
          end
          subgraph priv["Private subnets"]
            nodes@{ icon: "aws:res-amazon-ec2-instances", label: "EKS nodes<br/>managed group and Karpenter", pos: "b", h: 48 }
            msk@{ icon: "aws:amazon-managed-streaming-for-apache-kafka", label: "Amazon MSK<br/>when kafka.provider is msk", pos: "b", h: 80 }
          end
        end
      end
    end
  end
  clients -->|"events"| nlb
  clients -.->|"tunnel"| fwd
  eks -->|"schedules"| priv
  nlb --> nodes
  fwd -.-> nodes
  nodes --> msk
  nodes --> s3ep
  s3ep --> s3
  nodes -.-> nat
  nat -.->|"Kafka"| saas
  class saas part
  classDef ingest fill:#FFFFFF,stroke:#0E8A7D,stroke-width:3px,color:#0F172A
  classDef xform fill:#FFFFFF,stroke:#7B4FB0,stroke-width:3px,color:#0F172A
  classDef load fill:#FFFFFF,stroke:#0072B2,stroke-width:3px,color:#0F172A
  classDef bus fill:#FFFFFF,stroke:#A8517F,stroke-width:3px,color:#0F172A
  classDef store fill:#FFFFFF,stroke:#00785A,stroke-width:3px,color:#0F172A
  classDef ui fill:#FFFFFF,stroke:#D9480F,stroke-width:3px,color:#0F172A
  classDef ext fill:#F4F6F8,stroke:#94A3B8,stroke-width:1.5px,stroke-dasharray:5 4,color:#0F172A
  classDef decision fill:#FFFFFF,stroke:#9A6700,stroke-width:3px,color:#0F172A
  classDef error fill:#FFFFFF,stroke:#C2410C,stroke-width:3px,color:#0F172A
  classDef control fill:#FFFFFF,stroke:#334155,stroke-width:3px,color:#0F172A
  classDef part fill:#FFFFFF,stroke:#94A3B8,stroke-width:1.5px,color:#0F172A
  style cloud fill:none,stroke:#000000,stroke-width:1.5px,color:#000000
  style region fill:none,stroke:#00A4A6,stroke-width:1.5px,stroke-dasharray:3 3,color:#000000
  style vpc fill:none,stroke:#8C4FFF,stroke-width:1.5px,color:#000000
  style az fill:none,stroke:#00A4A6,stroke-width:1.5px,stroke-dasharray:8 6,color:#000000
  style pub fill:none,stroke:#7AA116,stroke-width:1.5px,color:#000000
  style priv fill:none,stroke:#00A4A6,stroke-width:1.5px,color:#000000
