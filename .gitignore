# Terraform / OpenTofu
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfplan
# Real per-environment tfvars hold cluster-specific endpoints -- keep them out of
# this publicly shipping repo. Commit terraform.tfvars.example (placeholders)
# instead; each operator copies it to terraform.tfvars locally.
**/terraform.tfvars
!**/terraform.tfvars.example
# bare `terraform plan -out=tfplan` output -- the *.tfplan glob misses it, and a
# plan can embed secret values (.gitignore has no inline comments, so keep this
# on its own line above the bare pattern)
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Helm — exclude downloaded charts but keep dfe-common library chart
# (ArgoCD needs the packaged library chart since it can't resolve file:// deps)
**/charts/*.tgz
# helm/charts/<chart> and helm/edge/<chart> both vendor it.
!helm/*/*/charts/dfe-common-*.tgz

# Secrets / certs
*.pem
*.key
*.p12
.env
.env.*
!.env.example
# bootstrap secret env (holds AppRole secret-id, GHCR PAT) -- the bare `.env`
# pattern misses this named file, so ignore it explicitly. Never commit.
bootstrap/local.env

# Deployment dial working copy -- render_dial.py reads it, and once populated it
# carries estate endpoints. deployment.example.yaml is the committed template.
/deployment.yaml

# resolve_sizing.py's answers for a resolve run with no --out, which lands them
# here: they name a deployment's fleet shape and hourly compute rate, so they
# belong to that deployment rather than this repo. sizing.yaml, targets/ and
# measurements/ are the committed INPUTS and stay tracked.
/sizing/resolved.yaml
/sizing/*.values.yaml
/sizing/*.report.md
/sizing/*.nodes.json
/sizing/*.karpenter.json
/sizing.auto.tfvars.json

# Scratch / temp
.tmp/
# Worktrees (any .wt-<topic>/ checkout rooted in the repo)
.wt-*/

# Python bytecode
__pycache__/
*.pyc

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# AI agent working files (not committed)
docs/superpowers/

# OS junk (never useful in repo)
Thumbs.db
*.swo
*~

# Local environment files (never commit -- contain secrets)
!.env.example.*

# Key material generated by a local run. A signing key in git is a
# compromised signing key.
.secrets/

# Local test artefacts
.coverage*
cov.xml

# Local working files (not committed)
#
# Authoritative protection for hyperi-ai content is .git/info/exclude
# (per-repo, never committed). The entries below ALSO appear there;
# duplicating them in .gitignore is belt-and-braces -- if a developer
# uses a tool that doesn't respect .git/info/exclude (unusual), the
# .gitignore still catches it. We do not RELY on these being committed
# in .gitignore -- attach surgically appends them if missing, leaves
# them alone if already present.
.mcp.json
.ai-version

# Plans workspace (planning skill): local by DEFAULT, committed by
# CHOICE. Contents excluded (not the dir) so shared/ can be
# re-included -- git cannot re-include inside an excluded directory.
docs/plans/*
!docs/plans/shared/

# hyperi-ai per-project context + tool-specific equivalents.
# Real files in project tree (Claude Code / Codex / Gemini / Cursor
# all load these from project root natively). Local-only, never
# committed -- mirrored in .git/info/exclude.
CLAUDE.md
TODO.md
AGENTS.md
GEMINI.md
.claude/
.codex/
.cursor/
.gemini/
.cursorrules

# hyperi-ai per-project workspace (plans, sessions, scratch). NEVER
# committed -- it holds working notes, not project content. Mirrored
# in .git/info/exclude, which is the authoritative copy.
.hyperi-ai/

# Git worktrees (local dev convenience)
.worktrees/

# Playwright MCP session artefacts (interactive browser driving)
.playwright-mcp/

# kubectl's discovery cache, which lands here rather than under $HOME when a
# tool invokes kubectl without one.
.kube/

# Local scratch / tmp (CORE.md: scratch goes here, gitignored, NOT
# /tmp). Bare patterns (no leading slash) match a tmp dir at ANY
# depth, so these cover top-level .tmp/ and tmp/ as well as nested
# ones like tests/tmp/. Mirrored in attach.py _DEFAULT_EXCLUDES.
tmp/
