# ---------------------------------------------------------------------------
# Subcommands -- argparse in, the suite module out
# ---------------------------------------------------------------------------


def cmd_ship(spec: ShipSpec, args: argparse.Namespace) -> int:
    """Release scalo itself, landing any staged fix through a PR first."""
    return ship_library(
        spec,
        repo_dir=args.repo_dir,
        org=args.org,
        subject=args.subject,
        dry_run=args.dry_run,
    )


def cmd_rebuild_rs(args: argparse.Namespace) -> int:
    """Move one Rust consumer onto a new scalo and release it."""
    return rebuild_rust(
        args.app_dir,
        args.version,
        subject=args.subject,
        run_tests=not args.no_tests,
        emit_chart=not args.no_chart,
        watch=not args.no_watch,
        dry_run=args.dry_run,
        org=args.org,
        release_unoptimized=args.release_unoptimized,
    )


def cmd_rebuild_py(args: argparse.Namespace) -> int:
    """Move one Python consumer onto a new scalo and release it."""
    return rebuild_python(
        args.app_dir,
        args.version,
        subject=args.subject,
        watch=not args.no_watch,
        dry_run=args.dry_run,
        org=args.org,
    )


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    """Assemble the argument parser."""
    parser = argparse.ArgumentParser(
        prog="dfe-fleet",
        description=(
            "Ship scalo and rebuild its downstream fleet. Main is protected, so "
            "every change lands as a branch, a PR, and a squash merge whose "
            "message carries the release trailer."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  git add <fix-files>\n"
            "  dfe-fleet ship-rs 'fix: <root cause>'\n"
            "  dfe-fleet ship-py\n"
            "  dfe-fleet rebuild-rs ~/projects/dfe-fetcher 2.11.0\n"
            "  dfe-fleet rebuild-rs ~/projects/dfe-loader 2.11.0 --no-tests\n"
            "  dfe-fleet rebuild-rs ~/projects/dfe-loader 2.11.0 --release-unoptimized\n"
            "  dfe-fleet rebuild-py ~/projects/dfe-engine 2.29.10\n"
        ),
    )
    parser.add_argument(
        "--org",
        default=DEFAULT_ORG,
        help=f"GitHub org used when the remote cannot be read (default: {DEFAULT_ORG})",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="say what would happen, touch nothing",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    def add_shared(target: argparse.ArgumentParser) -> None:
        """Repeat the global flags on a subcommand, so either position works.

        SUPPRESS rather than a default, so an unused subcommand flag does not
        overwrite the value given before the subcommand.
        """
        target.add_argument("--org", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        target.add_argument(
            "-n",
            "--dry-run",
            action="store_true",
            default=argparse.SUPPRESS,
            help="say what would happen, touch nothing",
        )

    for name, help_text in (
        ("ship-rs", "release scalo (Rust) to crates.io"),
        ("ship-py", "release scalo (Python) to PyPI"),
    ):
        ship = sub.add_parser(name, help=help_text)
        add_shared(ship)
        ship.add_argument(
            "subject",
            nargs="?",
            default="",
            help="conventional-commit subject, required when a fix is staged",
        )
        ship.add_argument("--repo-dir", help="the checkout, if it is not where we look")

    for name, help_text in (
        ("rebuild-rs", "move a Rust consumer onto a new scalo"),
        ("rebuild-py", "move a Python consumer onto a new scalo"),
    ):
        rebuild = sub.add_parser(name, help=help_text)
        add_shared(rebuild)
        rebuild.add_argument("app_dir", help="the consumer's checkout")
        rebuild.add_argument("version", help="the scalo version to move onto")
        rebuild.add_argument(
            "subject",
            nargs="?",
            default="",
            help="commit subject (default: fix: rebuild on ...)",
        )
        rebuild.add_argument(
            "--no-watch",
            action="store_true",
            help="merge and return, do not follow the release",
        )
        if name == "rebuild-rs":
            rebuild.add_argument(
                "--no-tests",
                action="store_true",
                help="skip the local nextest gate (dfe-loader: its suite is Docker-bound)",
            )
            rebuild.add_argument(
                "--no-chart",
                action="store_true",
                help=(
                    "skip chart/ regeneration (for an app with neither an "
                    "emit-chart subcommand nor a helm_contract test -- "
                    "dfe-receiver today)"
                ),
            )
            rebuild.add_argument(
                "--release-unoptimized",
                action="store_true",
                help=(
                    "release a consumer with build.skip_optimize set as an unoptimised "
                    "build: land with no release trailer, then dispatch ci.yml with the "
                    "per-run consent inputs skip-optimize and release-unoptimized, which "
                    "a push run cannot carry. The caller ci.yml must declare both as "
                    "workflow_dispatch inputs and forward both in with:"
                ),
            )
    return parser


def main(argv: list[str] | None = None) -> int:
    """Entry point. Returns the process exit code -- non-zero means STOP."""
    for stream in (sys.stdout, sys.stderr):
        if isinstance(stream, io.TextIOWrapper):
            stream.reconfigure(encoding="utf-8", errors="replace")
    args = build_parser().parse_args(argv)
    handlers = {
        "ship-rs": lambda: cmd_ship(SHIP_RS, args),
        "ship-py": lambda: cmd_ship(SHIP_PY, args),
        "rebuild-rs": lambda: cmd_rebuild_rs(args),
        "rebuild-py": lambda: cmd_rebuild_py(args),
    }
    try:
        return handlers[args.command]()
    except FleetError as exc:
        print(f"[{tag()}] ERROR: {exc}", file=sys.stderr, flush=True)
        return 1
    except KeyboardInterrupt:
        print(f"[{tag()}] interrupted", file=sys.stderr, flush=True)
        return 130


if __name__ == "__main__":
    sys.exit(main())
