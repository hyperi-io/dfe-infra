{
  "schema_version": 4,
  "app_name": "dfe-receiver",
  "binary_name": "dfe-receiver",
  "description": "High-performance HTTP/gRPC receiver for PB/s scale data ingestion",
  "metrics_port": 9090,
  "health": {
    "liveness_path": "/livez",
    "readiness_path": "/readyz",
    "metrics_path": "/metrics",
    "startup_budget_seconds": 60
  },
  "env_prefix": "DFE_RECEIVER",
  "metric_prefix": "receiver",
  "config_mount_path": "/etc/dfe-receiver/config.yaml",
  "image_registry": "ghcr.io/hyperi-io",
  "extra_ports": [
    {
      "name": "http",
      "port": 8080,
      "protocol": "TCP",
      "bound_from": "server.bind_address",
      "public": true
    },
    {
      "name": "grpc",
      "port": 6000,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.grpc.enabled",
        "value": "true"
      },
      "bound_from": "grpc.bind_address",
      "app_protocol": "kubernetes.io/h2c"
    },
    {
      "name": "otlp-grpc",
      "port": 4317,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.otlp.enabled",
        "value": "true"
      },
      "bound_from": "otlp.grpc_bind_address",
      "public": true
    },
    {
      "name": "otlp-http",
      "port": 4318,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.otlp.enabled",
        "value": "true"
      },
      "bound_from": "otlp.http_bind_address",
      "public": true
    },
    {
      "name": "beats",
      "port": 5044,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.lumberjack.enabled",
        "value": "true"
      },
      "bound_from": "lumberjack.bind_address",
      "public": true
    },
    {
      "name": "hec",
      "port": 8088,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.splunk_hec.enabled",
        "value": "true"
      },
      "bound_from": "splunk_hec.bind_address",
      "public": true
    },
    {
      "name": "prometheus-rw",
      "port": 9091,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.prometheus_rw.enabled",
        "value": "true"
      },
      "bound_from": "prometheus_rw.bind_address",
      "public": true
    },
    {
      "name": "webhook",
      "port": 8090,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.webhook.enabled",
        "value": "true"
      },
      "bound_from": "webhook.bind_address",
      "public": true
    },
    {
      "name": "syslog",
      "port": 514,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.syslog.enabled",
        "value": "true"
      },
      "bound_from": "syslog.tcp_bind_address",
      "public": true
    },
    {
      "name": "syslog-udp",
      "port": 514,
      "protocol": "UDP",
      "when": {
        "kind": "equals",
        "path": "config.syslog.enabled",
        "value": "true"
      },
      "bound_from": "syslog.udp_bind_address",
      "public": true
    },
    {
      "name": "syslog-tls",
      "port": 6514,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.syslog.enabled",
        "value": "true"
      },
      "bound_from": "syslog.tls_bind_address",
      "public": true
    },
    {
      "name": "fluent",
      "port": 24224,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.fluent.enabled",
        "value": "true"
      },
      "bound_from": "fluent.bind_address",
      "public": true
    },
    {
      "name": "gelf",
      "port": 12201,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.gelf.enabled",
        "value": "true"
      },
      "bound_from": "gelf.bind_address",
      "public": true
    },
    {
      "name": "netflow",
      "port": 2055,
      "protocol": "UDP",
      "when": {
        "kind": "equals",
        "path": "config.flow.enabled",
        "value": "true"
      },
      "bound_from": "flow.bind_address",
      "public": true
    },
    {
      "name": "netflow-ipfix",
      "port": 4739,
      "protocol": "UDP",
      "when": {
        "kind": "equals",
        "path": "config.flow.enabled",
        "value": "true"
      },
      "bound_from": "flow.bind_address",
      "public": true
    },
    {
      "name": "sflow",
      "port": 6343,
      "protocol": "UDP",
      "when": {
        "kind": "equals",
        "path": "config.flow.enabled",
        "value": "true"
      },
      "bound_from": "flow.bind_address",
      "public": true
    }
  ],
  "entrypoint_args": [
    "--config",
    "/etc/dfe-receiver/config.yaml"
  ],
  "secrets": [
    {
      "group_name": "kafka",
      "env_vars": [
        {
          "env_var": "DFE_RECEIVER_KAFKA_SASL_USER",
          "key_name": "username",
          "secret_key": "kafka-username"
        },
        {
          "env_var": "DFE_RECEIVER_KAFKA_SASL_PASSWORD",
          "key_name": "password",
          "secret_key": "kafka-password"
        },
        {
          "env_var": "DFE_RECEIVER_KAFKA_SASL_MECHANISM",
          "key_name": "mechanism",
          "secret_key": "kafka-sasl-mechanism"
        }
      ]
    },
    {
      "group_name": "auth",
      "env_vars": [
        {
          "env_var": "DFE_RECEIVER_BEARER_TOKENS",
          "key_name": "bearer-tokens",
          "secret_key": "bearer-tokens"
        }
      ],
      "optional": true
    }
  ],
  "default_config": {
    "server": {
      "bind_address": "0.0.0.0:8080",
      "max_body_size": 10485760,
      "request_timeout_ms": 30000,
      "auth": {
        "mode": "none"
      }
    },
    "grpc": {
      "enabled": false,
      "bind_address": "0.0.0.0:6000"
    },
    "otlp": {
      "enabled": false,
      "grpc_bind_address": "0.0.0.0:4317",
      "http_bind_address": "0.0.0.0:4318",
      "mode": "hyperdx"
    },
    "lumberjack": {
      "enabled": false,
      "bind_address": "0.0.0.0:5044"
    },
    "splunk_hec": {
      "enabled": false,
      "bind_address": "0.0.0.0:8088"
    },
    "prometheus_rw": {
      "enabled": false,
      "bind_address": "0.0.0.0:9091"
    },
    "webhook": {
      "enabled": false,
      "bind_address": "0.0.0.0:8090"
    },
    "syslog": {
      "enabled": false,
      "udp_bind_address": "0.0.0.0:514",
      "tcp_bind_address": "0.0.0.0:514",
      "tls_bind_address": "0.0.0.0:6514"
    },
    "fluent": {
      "enabled": false,
      "bind_address": "0.0.0.0:24224"
    },
    "gelf": {
      "enabled": false,
      "bind_address": "0.0.0.0:12201"
    },
    "flow": {
      "enabled": false,
      "experimental": true,
      "bind_address": "0.0.0.0",
      "ports": [
        2055,
        4739,
        6343
      ],
      "output": {
        "mode": "canonical",
        "max_records_per_packet": 200
      },
      "channel_capacity": 4096,
      "recv_buffer_bytes": 8388608,
      "rate_limit": {
        "enabled": false,
        "packets_per_second": 5000,
        "burst": 10000,
        "cache_size": 4096
      },
      "netflow": {
        "enabled": true,
        "template_cache": {
          "max_per_exporter": 1000,
          "max_exporters": 10000
        },
        "topic": "netflow_land"
      },
      "sflow": {
        "enabled": true,
        "topic": "sflow_land"
      }
    },
    "kafka": {
      "brokers": [
        "kafka:9092"
      ],
      "client_id": "dfe-receiver"
    },
    "routing": {
      "default_source": "main",
      "topic_suffix": "_land"
    },
    "metrics": {
      "enabled": true,
      "address": "0.0.0.0:9090"
    }
  },
  "depends_on": [
    "kafka"
  ],
  "keda": {
    "enabled": true,
    "min_replicas": 1,
    "max_replicas": 10,
    "polling_interval": 15,
    "cooldown_period": 120,
    "kafka_lag_threshold": 1000,
    "activation_lag_threshold": 0,
    "cpu_enabled": true,
    "cpu_threshold": 80,
    "kafka_trigger": {
      "enabled": false,
      "brokers_path": "config.kafka.brokers",
      "group_path": "config.kafka.group_id",
      "topics_path": "config.kafka.topics"
    }
  },
  "writable_paths": [
    {
      "name": "spool",
      "path": "/var/spool/dfe-receiver",
      "size_limit": "10Gi",
      "size": "1Gi",
      "when": {
        "kind": "equals",
        "path": "config.buffer.spillover.enabled",
        "value": "true"
      }
    }
  ],
  "termination_grace_seconds": 45,
  "resources": {
    "requests": {
      "cpu": "200m",
      "memory": "256Mi"
    },
    "limits": {
      "cpu": "1",
      "memory": "512Mi"
    }
  },
  "security": {
    "run_as_user": 1000,
    "run_as_group": 1000,
    "fs_group": 1000,
    "read_only_root_filesystem": true
  },
  "singleton": false
}
