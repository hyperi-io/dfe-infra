{
  "schema_version": 4,
  "app_name": "dfe-archiver",
  "description": "High-volume Kafka-to-storage archiver for PB/s scale data pipelines",
  "metrics_port": 9090,
  "health": {
    "liveness_path": "/livez",
    "readiness_path": "/readyz",
    "metrics_path": "/metrics",
    "startup_budget_seconds": 120
  },
  "env_prefix": "ARCHIVER",
  "metric_prefix": "archiver",
  "config_mount_path": "/etc/dfe/archiver.yaml",
  "image_registry": "ghcr.io/hyperi-io",
  "extra_ports": [
    {
      "name": "push",
      "port": 6000,
      "protocol": "TCP",
      "when": {
        "kind": "equals",
        "path": "config.transport",
        "value": "grpc"
      },
      "bound_from": "grpc.listen",
      "app_protocol": "kubernetes.io/h2c"
    }
  ],
  "entrypoint_args": [
    "--config",
    "/etc/dfe/archiver.yaml"
  ],
  "secrets": [
    {
      "group_name": "kafka",
      "env_vars": [
        {
          "env_var": "KAFKA_SASL_USER",
          "key_name": "username",
          "secret_key": "username"
        },
        {
          "env_var": "KAFKA_SASL_PASSWORD",
          "key_name": "password",
          "secret_key": "password"
        },
        {
          "env_var": "KAFKA_SASL_MECHANISM",
          "key_name": "mechanism",
          "secret_key": "sasl.mechanism"
        }
      ]
    },
    {
      "group_name": "s3",
      "env_vars": [
        {
          "env_var": "S3_ACCESS_KEY_ID",
          "key_name": "access_key_id",
          "secret_key": "access_key_id"
        },
        {
          "env_var": "S3_SECRET_ACCESS_KEY",
          "key_name": "secret_access_key",
          "secret_key": "secret_access_key"
        }
      ],
      "optional": true
    }
  ],
  "keda": {
    "enabled": true,
    "min_replicas": 1,
    "max_replicas": 10,
    "polling_interval": 15,
    "cooldown_period": 300,
    "kafka_lag_threshold": 1000,
    "activation_lag_threshold": 0,
    "cpu_enabled": true,
    "cpu_threshold": 80,
    "kafka_trigger": {
      "enabled": false
    }
  },
  "writable_paths": [
    {
      "name": "spool",
      "path": "/var/spool/dfe/archiver",
      "size_limit": "10Gi"
    }
  ],
  "termination_grace_seconds": 45,
  "resources": {
    "requests": {
      "cpu": "100m",
      "memory": "128Mi"
    },
    "limits": {
      "cpu": "500m",
      "memory": "512Mi"
    }
  },
  "security": {
    "run_as_user": 1000,
    "run_as_group": 1000,
    "fs_group": 1000,
    "read_only_root_filesystem": true
  },
  "singleton": false
}
