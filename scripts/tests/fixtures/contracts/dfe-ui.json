{
  "schema_version": 4,
  "app_name": "dfe-ui",
  "description": "DFE web console: the Next.js UI over the dfe-engine API",
  "metrics_port": 3000,
  "health": {
    "liveness_path": "/livez",
    "readiness_path": "/readyz",
    "metrics_path": "/metrics",
    "startup_budget_seconds": 60
  },
  "env_prefix": "",
  "metric_prefix": "",
  "config_mount_path": "",
  "image_registry": "ghcr.io/hyperi-io",
  "secrets": [
    {
      "group_name": "nextauth",
      "env_vars": [
        {
          "env_var": "NEXTAUTH_SECRET",
          "key_name": "secret",
          "secret_key": "secret"
        }
      ],
      "optional": false
    }
  ],
  "keda": {
    "enabled": true,
    "min_replicas": 1,
    "max_replicas": 5,
    "polling_interval": 15,
    "cooldown_period": 300,
    "kafka_lag_threshold": 1000,
    "activation_lag_threshold": 0,
    "cpu_enabled": true,
    "cpu_threshold": 70,
    "kafka_trigger": {
      "enabled": false
    }
  },
  "writable_paths": [],
  "termination_grace_seconds": 30,
  "resources": {
    "requests": {
      "cpu": "100m",
      "memory": "256Mi"
    },
    "limits": {
      "cpu": "500m",
      "memory": "512Mi"
    }
  },
  "security": {
    "run_as_user": 1001,
    "run_as_group": 1001,
    "fs_group": 1001,
    "read_only_root_filesystem": false
  },
  "singleton": false
}
