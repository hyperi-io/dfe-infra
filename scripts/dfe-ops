#!/usr/bin/env python3
#  Project:      dfe-infra
#  File:         dfe-ops
#  Purpose:      One CLI for DFE cluster operations -- kubeconfig fetch, HTTP
#                probe, and the deploy/teardown/verify lifecycle. Consolidates
#                the scattered ops helpers into a single dfe-cli-style command
#                with subcommands. GENERIC: every environment-specific value
#                (Vault path, node, cloud, server, ...) is a flag, so it serves
#                ANY cluster (pet, dfe, a customer's), not just one. Runs under
#                the python3 allow-list; stdlib only, no third-party deps.
#  Language:     Python
#
#  License:      BUSL-1.1
#  Copyright:    (c) 2026 HYPERI PTY LIMITED
"""dfe-ops -- one command for DFE cluster operations.

    python3 scripts/dfe-ops <subcommand> [options]      # or ./scripts/dfe-ops ...

Subcommands:
  kubeconfig   Fetch a node's kubeconfig via a Vault/OpenBao-stored SSH key,
               rewriting the loopback API server to a reachable address.
  probe        Minimal curl-equivalent HTTP client (stdlib urllib) for smoke
               tests + health checks where curl is unavailable or blocked.
  deploy-values Get/put/delete a values file in the bundled deploy repo via the
               Gitea-family contents API (credential read in-process from the
               cluster Secret, never argv). Adding/removing a values file IS
               the deploy on the layer2-apps fan-out.
  deploy       Deploy DFE to a target cloud (wraps bootstrap/deploy.sh:
               terraform -> bridge -> bootstrap -> Argo).
  stack-deploy Drive one END-TO-END deploy of a PINNED stack version in a chosen
               MODE (slim|single|scale) onto an EXISTING cluster: offline
               pre-flight (pins resolve, no drift, mode charts render) ->
               bootstrap (Layer 0/1 + Argo sync of the mode's profile at the
               SSoT-pinned versions) -> bounded readiness gate -> the two default
               E2E tests -> access summary. Provisions NOTHING (deploy ONTO, not
               create). The stack + mode + kubeconfig are flags; secrets come from
               --env-file / --from-terraform, never hardcoded.
  preflight    READ-ONLY cluster-contract check: is this (Rancher/any) cluster
               right for a DFE deployment? Verifies what bootstrap cannot fix
               (API access, RBAC, Ready nodes, the workload-label trap) and
               previews what it will decide (adopt-or-install, storage
               fallback). Changes nothing.
  cycle        THE repeatable validation loop this repo owns: preflight ->
               stack-deploy (+ the 2 default E2E tests) -> full smoke suite ->
               destroy. Every estate-specific value comes from --env-file;
               --keep skips the destroy for dev-cluster debugging.
  teardown     Tear the deployment down (wraps bootstrap/destroy.sh); optionally
               also destroy terraform state.
  verify       Run the full smoke-test suite (wraps bootstrap/run-all-smoke-tests.sh),
               or just the readiness gate.
  refresh      Upgrade a PERSISTENT deploy in place: hard-refresh every Argo
               Application so a pushed commit on the tracked ref lands NOW
               rather than at the next poll, WAIT for those syncs to finish,
               then re-prove the deploy with the readiness gate and the same
               smoke suite `verify` runs. Deploys nothing itself -- Argo already
               tracks the ref, so `git push` is the change and this is the
               "land it and prove it" half.
  pin          Resolve a pinned version (tag) to its current GHCR digest and,
               with --write, set the current stack's digests: in versions.yaml
               (supply-chain cooldown honoured). --check is the read-only "are my
               pins fresh" gate. Kills the hand look-up-a-sha-and-paste loop. The
               tag->digest core (scripts/registry_pins.py) is what dfe-deploy
               reuses to resolve an overlay's image.tag.

Examples (addresses are RFC 5737 documentation IPs, never a real estate's --
this file is committed publicly, so substitute your own node):
    # Pull a cluster's kubeconfig from one of its server nodes to a local file:
    python3 scripts/dfe-ops kubeconfig --node 192.0.2.10 --out .tmp/dfe.kubeconfig

    # Probe an endpoint (prints the status line then the body):
    python3 scripts/dfe-ops probe GET http://localhost:8000/readyz

    # Deploy to the local Rancher/RKE2 cluster, then verify:
    python3 scripts/dfe-ops deploy --cloud local
    python3 scripts/dfe-ops verify

    # Offline-only: validate stack + mode render before touching a cluster:
    python3 scripts/dfe-ops stack-deploy --stack 2.2.0-rc.1 --mode single --check-only

    # Deploy stack 2.2.0-rc.1 in single mode onto the existing dfe-k8s cluster,
    # secrets from a terraform env dir, then run the two default E2E tests:
    python3 scripts/dfe-ops stack-deploy --stack 2.2.0-rc.1 --mode single \
        --kubeconfig .tmp/dfe.kubeconfig --from-terraform terraform/environments/local

    # Same, secrets from an env file (no terraform), scale mode:
    python3 scripts/dfe-ops stack-deploy --mode scale --kubeconfig .tmp/dfe.kubeconfig \
        --env-file bootstrap/local.env

    # Is this cluster fit for a DFE deployment? (read-only; the label check is
    # the wrong-cluster trap-catcher):
    python3 scripts/dfe-ops preflight --mode scale --env-file bootstrap/.env \
        --require-label dfe.hyperi.io/workload=dfe

    # THE validation cycle -- clone, get the env file (e.g. via Bitwarden), go:
    python3 scripts/dfe-ops cycle --mode single --kubeconfig .tmp/dfe.kubeconfig \
        --env-file bootstrap/.env

    # Land a push on the persistent deploy's tracked ref, then re-prove it:
    python3 scripts/dfe-ops refresh --mode slim --kubeconfig .tmp/dfe.kubeconfig \
        --env-file bootstrap/.env

    # Preview a teardown, then run it (also destroying terraform state):
    python3 scripts/dfe-ops teardown --dry-run
    python3 scripts/dfe-ops teardown --force --with-terraform

kubeconfig + probe need only python3. deploy/stack-deploy/teardown/verify shell
out to the repo's bootstrap/*.sh + scripts/dfe-stack (found relative to this
file), so they need whatever those need (kubectl, helm, terraform/tofu on PATH,
VAULT_* env, ...). stack-deploy's pre-flight needs only python3 + helm.
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import secrets
import shutil
import ssl
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
BOOTSTRAP = REPO_ROOT / "bootstrap"
SCRIPTS = REPO_ROOT / "scripts"
HELM_CHARTS = REPO_ROOT / "helm" / "charts"
ARGO_VALUES = REPO_ROOT / "argocd" / "values"
DFE_STACK = SCRIPTS / "dfe-stack"
DRIFT_CHECK = SCRIPTS / "check_versions_drift.py"
NAMESPACE_DRIFT_CHECK = SCRIPTS / "check_namespace_drift.py"

# `pin` (version -> registry digest resolve/check/write) lives in resolve_pins so
# the standalone tool and `dfe-ops pin` are one code path (dfe-infra#116).
sys.path.insert(0, str(SCRIPTS))
from resolve_pins import add_pin_subparser  # noqa: E402

# The deploy MODES (== the appset profile value each selects). One lever --
# DFE_PROFILE -- drives the whole stack: the cluster secret's label (which gates
# the scale-only operator appsets) AND its annotation (which selects
# argocd/values/profile-<mode>.yaml). slim = gRPC, no Kafka, single-node CH;
# single = one node of everything WITH Kafka (non-operator broker); scale = HA,
# operator ClickHouse cluster + Strimzi Kafka.
MODES = ("slim", "single", "scale")
DEFAULT_STACK = "2.2.0-rc.1"
DEFAULT_REGISTRY = "ghcr.io/hyperi-io"

# bootstrap.sh's required env (validated up-front so a missing var fails the
# driver before it touches the cluster, not mid-run). DFE_KAFKA_BOOTSTRAP is
# intentionally omitted -- it is empty in slim (gRPC transport).
BOOTSTRAP_REQUIRED = (
    "DFE_ENV",
    "DFE_CLOUD",
    "DFE_REGION",
    "DFE_DOMAIN",
    "DFE_PROFILE",
    "DFE_REPO_URL",
    "DFE_TARGET_REVISION",
    "DFE_STORAGE_CLASS",
    "DFE_NAMESPACE",
    "DFE_CLICKHOUSE_HOST",
    "DFE_OTEL_ENDPOINT",
    "DFE_VAULT_ADDR",
    "DFE_VAULT_ROLE_ID",
    "DFE_WORKLOAD_IDENTITY_ANNOTATIONS",
)

# Substrate charts each mode actually deploys -- drives the offline helm-render
# pre-flight. slim: single-node ClickHouse only (no Kafka). single/scale: also
# Kafka (single renders a non-operator StatefulSet; scale renders the Strimzi CR,
# whose operator layer-scale.yaml installs). A representative set of app charts is
# always rendered too, so an app-side profile break is caught before deploy.
_MODE_SUBSTRATE = {
    "slim": ("clickhouse-cluster",),
    "single": ("clickhouse-cluster", "kafka"),
    "scale": ("clickhouse-cluster", "kafka"),
}
_PREFLIGHT_APPS = ("dfe-receiver", "dfe-loader", "dfe-engine")

# --- kubeconfig defaults -----------------------------------------------------
DEFAULT_USER = "ubuntu"
DEFAULT_VAULT_PATH = "kv/infrastructure/ssh"
DEFAULT_VAULT_FIELD = "private_key_b64"
DEFAULT_REMOTE_PATH = "/etc/rancher/rke2/rke2.yaml"
DEFAULT_VAULT_CMD = "bao"
# rke2/k3s write the loopback server here; rewrite it to a reachable address.
_LOOPBACK_SERVERS = ("https://127.0.0.1:6443", "https://[::1]:6443")


# --- shared shell helpers ----------------------------------------------------
def _run_capture(cmd: list[str]) -> subprocess.CompletedProcess:
    """Run a subprocess, capturing output; raise CalledProcessError on failure."""
    return subprocess.run(
        cmd, capture_output=True, check=True
    )


def _run_streaming(cmd: list[str], *, env: dict | None = None) -> int:
    """Run a subprocess inheriting stdio (live output); return its exit code."""
    print(f"==> {' '.join(cmd)}", file=sys.stderr)
    return subprocess.run(cmd, env=env).returncode


# --- kubeconfig subcommand ---------------------------------------------------
def _read_ssh_key(vault_cmd: str, path: str, field: str) -> bytes:
    """Read the base64 SSH private key from Vault/OpenBao and decode it."""
    proc = _run_capture([vault_cmd, "kv", "get", f"-field={field}", path])
    return base64.b64decode(proc.stdout)


def _fetch_remote(user: str, node: str, remote_path: str, key_file: str) -> str:
    """SSH to the node and return the remote kubeconfig text."""
    proc = _run_capture(
        [
            "ssh",
            "-i",
            key_file,
            "-o",
            "StrictHostKeyChecking=accept-new",
            "-o",
            "ConnectTimeout=15",
            f"{user}@{node}",
            f"cat {remote_path} 2>/dev/null || sudo cat {remote_path}",
        ]
    )
    return proc.stdout.decode("utf-8")


def _rewrite_server(kubeconfig: str, server: str) -> str:
    """Replace the loopback API-server URL with a reachable one."""
    out = kubeconfig
    for loopback in _LOOPBACK_SERVERS:
        out = out.replace(loopback, server)
    return out


def cmd_kubeconfig(args: argparse.Namespace) -> int:
    if not os.environ.get("VAULT_ADDR"):
        print("VAULT_ADDR is not set (export it, or source your env)", file=sys.stderr)
        return 2

    server = args.server or f"https://{args.node}:6443"

    key_bytes = _read_ssh_key(args.vault_cmd, args.vault_path, args.vault_field)
    key_fd, key_file = tempfile.mkstemp(prefix="kc-ssh-", suffix=".key")
    try:
        os.write(key_fd, key_bytes)
        os.close(key_fd)
        os.chmod(key_file, 0o600)
        raw = _fetch_remote(args.user, args.node, args.remote_path, key_file)
    finally:
        os.unlink(key_file)  # the private key never persists

    kubeconfig = _rewrite_server(raw, server)

    with open(args.out, "w", encoding="utf-8") as fh:
        fh.write(kubeconfig)
    os.chmod(args.out, 0o600)

    print(f"wrote {args.out} (server {server})")
    return 0


# --- probe subcommand --------------------------------------------------------
def cmd_probe(args: argparse.Namespace) -> int:
    headers: dict[str, str] = {}
    for h in args.header:
        if ":" not in h:
            print(f"bad header (expected 'K: V'): {h!r}", file=sys.stderr)
            return 2
        k, v = h.split(":", 1)
        headers[k.strip()] = v.strip()

    body: bytes | None = None
    if args.json is not None:
        body = args.json.encode("utf-8")
        headers.setdefault("Content-Type", "application/json")
    elif args.data is not None:
        body = args.data.encode("utf-8")

    ctx = None
    if args.insecure:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE

    req = urllib.request.Request(
        args.url, data=body, headers=headers, method=args.method.upper()
    )
    try:
        with urllib.request.urlopen(
            req, timeout=args.timeout, context=ctx
        ) as resp:
            status = resp.status
            resp_headers = resp.headers
            payload = resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:  # a response WITH an error status
        status = exc.code
        resp_headers = exc.headers
        payload = exc.read().decode("utf-8", "replace")
    except (urllib.error.URLError, TimeoutError, OSError) as exc:  # no response
        print(f"request failed: {exc}", file=sys.stderr)
        return 1

    print(f"HTTP {status}")
    if args.head:
        for k, v in resp_headers.items():
            print(f"{k}: {v}")
        print()
    print(payload)

    if args.fail and status >= 400:
        return 22  # mirror curl -f's exit code
    return 0


# --- deploy-values subcommand (deploy-repo values-file CRUD) ------------------
def _deploy_repo_cred(args: argparse.Namespace) -> tuple[str, str]:
    """Admin credential for the bundled deploy repo, read in-process from the
    cluster Secret bootstrap created -- never argv."""
    cmd = ["kubectl"]
    if args.kubeconfig:
        cmd += ["--kubeconfig", args.kubeconfig]
    cmd += ["-n", args.secret_namespace, "get", "secret", args.secret, "-o", "json"]
    out = subprocess.run(
        cmd, capture_output=True, text=True, check=True, encoding="utf-8", errors="replace"
    ).stdout
    data = json.loads(out)["data"]
    return (
        base64.b64decode(data["username"]).decode(),
        base64.b64decode(data["password"]).decode(),
    )


def cmd_deploy_values(args: argparse.Namespace) -> int:
    if args.action == "put" and not args.file:
        print("put needs --file", file=sys.stderr)
        return 2
    try:
        user, password = _deploy_repo_cred(args)
    except (subprocess.CalledProcessError, KeyError, json.JSONDecodeError) as exc:
        print(f"cannot read deploy-repo credential: {exc}", file=sys.stderr)
        return 1
    owner = args.owner or user
    auth = base64.b64encode(f"{user}:{password}".encode()).decode()
    headers = {"Authorization": f"Basic {auth}", "Content-Type": "application/json"}
    url = f"{args.url}/api/v1/repos/{owner}/{args.repo}/contents/{args.path}"

    # The Gitea-family contents API needs the current sha to update or delete.
    # A directory path returns a LIST (no sha): get prints the listing,
    # put/delete refuse.
    sha = None
    listing = None
    try:
        with urllib.request.urlopen(
            urllib.request.Request(url, headers=headers), timeout=args.timeout
        ) as resp:
            info = json.loads(resp.read())
            if isinstance(info, list):
                listing = info
            else:
                sha = info["sha"]
    except urllib.error.HTTPError as exc:
        if exc.code != 404:
            print(f"lookup failed: HTTP {exc.code}", file=sys.stderr)
            return 1

    if listing is not None and args.action != "get":
        print(f"{args.path} is a directory", file=sys.stderr)
        return 2

    if args.action == "get":
        if listing is not None:
            for entry in listing:
                print(f"{entry['type']}\t{entry['path']}")
            return 0
        if sha is None:
            print(f"absent: {args.path}")
            return 1
        with urllib.request.urlopen(
            urllib.request.Request(url, headers=headers), timeout=args.timeout
        ) as resp:
            print(base64.b64decode(json.loads(resp.read())["content"]).decode())
        return 0

    if args.action == "delete":
        if sha is None:
            print(f"already absent: {args.path}")
            return 0
        body = {"sha": sha, "message": args.message or f"remove {args.path}"}
        req = urllib.request.Request(
            url, data=json.dumps(body).encode(), headers=headers, method="DELETE"
        )
    else:  # put
        content = Path(args.file).read_text(encoding="utf-8")
        body = {
            "content": base64.b64encode(content.encode()).decode(),
            "message": args.message or f"update {args.path}",
        }
        if sha:
            body["sha"] = sha
        req = urllib.request.Request(
            url,
            data=json.dumps(body).encode(),
            headers=headers,
            method="PUT" if sha else "POST",
        )
    try:
        with urllib.request.urlopen(req, timeout=args.timeout) as resp:
            print(f"HTTP {resp.status} - {args.action} {args.path}")
    except urllib.error.HTTPError as exc:
        print(f"{args.action} failed: HTTP {exc.code} {exc.read().decode('utf-8', 'replace')[:300]}", file=sys.stderr)
        return 1
    return 0


# --- deploy / teardown / verify subcommands (wrap bootstrap/*.sh) ------------
def _require_script(name: str) -> Path | None:
    path = BOOTSTRAP / name
    if not path.exists():
        print(f"bootstrap script not found: {path}", file=sys.stderr)
        return None
    return path


def cmd_deploy(args: argparse.Namespace) -> int:
    script = _require_script("deploy.sh")
    if script is None:
        return 1
    cmd = ["bash", str(script), "--cloud", args.cloud]
    if args.tf_dir:
        cmd += ["--tf-dir", args.tf_dir]
    if args.dry_run:
        cmd.append("--dry-run")
    if args.skip_terraform:
        cmd.append("--skip-terraform")
    return _run_streaming(cmd)


def cmd_teardown(args: argparse.Namespace) -> int:
    script = _require_script("destroy.sh")
    if script is None:
        return 1
    env = dict(os.environ)
    cmd = ["bash", str(script)]
    if args.dry_run:
        env["DFE_DRY_RUN"] = "true"
    elif args.force:
        cmd.append("--force")
    rc = _run_streaming(cmd, env=env)
    if rc != 0 or not args.with_terraform:
        return rc
    # Optionally also destroy terraform state (OpenBao KV mounts + AppRoles).
    tf_dir = args.tf_dir or str(REPO_ROOT / "terraform" / "environments" / args.cloud)
    tf_cmd = [args.tf_bin, f"-chdir={tf_dir}", "destroy"]
    if args.dry_run:
        print(f"[dry-run] would run: {' '.join(tf_cmd)}", file=sys.stderr)
        return rc
    if args.force:
        tf_cmd.append("-auto-approve")  # non-interactive teardown when --force
    return _run_streaming(tf_cmd, env=env)


def _suite_env(args: argparse.Namespace) -> dict[str, str]:
    """The deploy's own env for a bootstrap test script: terraform, then env files.

    Every check in those scripts is namespace-scoped, so without these vars they
    read the compiled-in default namespace -- `dfe` rather than the deployed
    `dfe-local` -- and report a healthy stack as broken.
    """
    env = dict(os.environ)
    if args.from_terraform:
        sys.path.insert(0, str(BOOTSTRAP))
        from bridge import get_tf_outputs

        tf = {k: v for k, v in get_tf_outputs(args.from_terraform).items()
              if k.startswith("DFE_")}
        env.update(tf)
        print(f"  loaded {len(tf)} DFE_* var(s) from terraform {args.from_terraform}",
              file=sys.stderr)
    for env_file in args.env_file:
        loaded = _parse_env_file(env_file)
        env.update(loaded)
        print(f"  loaded {len(loaded)} var(s) from {env_file}", file=sys.stderr)
    if args.kubeconfig:
        env["KUBECONFIG"] = args.kubeconfig
    if args.mode:
        env["DFE_PROFILE"] = args.mode
    return env


def cmd_verify(args: argparse.Namespace) -> int:
    """Run the smoke suite against the SAME env the deploy used."""
    name = "smoke-test-readiness.sh" if args.readiness_only else "run-all-smoke-tests.sh"
    script = _require_script(name)
    if script is None:
        return 1
    return _run_streaming(["bash", str(script)], env=_suite_env(args))


# --- refresh subcommand (upgrade a persistent deploy in place) ----------------
# Seconds between Application polls while the annotated syncs run.
_SYNC_POLL_INTERVAL = 10
# Cluster-secret annotations naming the repos this deploy tracks.
_TRACKED_REPO_ANNOTATIONS = ("dfe.hyperi.io/repo_url", "dfe.hyperi.io/config_repo_url")


def _refresh_failed(stage: str, rc: int, detail: str = "") -> int:
    """The one shape every refresh stage failure prints; returns the code to exit."""
    print(f">>> refresh FAILED at stage {stage} (rc {rc})"
          f"{': ' + detail if detail else ''}", file=sys.stderr)
    return rc


def _refresh_ok(what: str) -> int:
    """The one shape a finished refresh prints; returns the code to exit."""
    print(f"\n>>> refresh OK: the tracked ref landed, {what}", file=sys.stderr)
    return 0


def _normalise_repo(url: str) -> str:
    """A repo URL reduced to what two spellings of the same repo share."""
    url = url.strip().rstrip("/")
    if url.endswith(".git"):
        url = url[: -len(".git")]
    return url.lower()


def _tracked_repos(kube: list[str], argocd_namespace: str, env: dict) -> list[str]:
    """The repo URLs this deploy tracks, off the dfe-cluster secret annotations."""
    rc, doc, _err = _kubectl_json(
        [*kube, "-n", argocd_namespace, "get", "secret", "dfe-cluster"], env=env
    )
    if rc != 0:
        return []
    ann = (doc.get("metadata") or {}).get("annotations") or {}
    return [_normalise_repo(ann[k]) for k in _TRACKED_REPO_ANNOTATIONS if ann.get(k)]


def _app_repos(app: dict) -> list[str]:
    """Every repo an Application draws from, single-source or multi-source."""
    spec = app.get("spec") or {}
    sources = list(spec.get("sources") or [])
    if spec.get("source"):
        sources.append(spec["source"])
    return [_normalise_repo(s["repoURL"]) for s in sources if s.get("repoURL")]


def _converging(apps: list[dict], repos: list[str]) -> list[str]:
    """One `<app> (<why>)` line per tracked Application that has not settled.

    Sync status alone would pass an Application whose operation is still Running,
    which is the window a gate run straight after the annotate lands in.
    """
    pending = []
    for app in apps:
        if repos and not any(r in repos for r in _app_repos(app)):
            continue
        name = (app.get("metadata") or {}).get("name", "<unnamed>")
        status = app.get("status") or {}
        sync = (status.get("sync") or {}).get("status") or "Unknown"
        health = (status.get("health") or {}).get("status") or "Unknown"
        phase = (status.get("operationState") or {}).get("phase") or ""
        if phase == "Running":
            pending.append(f"{name} (operation Running)")
        elif sync != "Synced":
            pending.append(f"{name} (sync {sync})")
        elif health != "Healthy":
            pending.append(f"{name} (health {health})")
    return pending


def _wait_for_sync(kube: list[str], argocd_namespace: str, repos: list[str],
                   timeout: int, env: dict) -> int:
    """Block until every tracked Application is Synced, Healthy and not operating.

    The readiness gate exits on its FIRST clean poll, so run without this it
    judges the pods the previous revision left behind.
    """
    deadline = time.monotonic() + timeout
    while True:
        rc, doc, err = _kubectl_json(
            [*kube, "-n", argocd_namespace, "get", "applications.argoproj.io"], env=env
        )
        if rc == 0:
            apps = doc.get("items") or []
            pending = _converging(apps, repos)
            if not pending:
                print(f"    {len(apps)} Application(s) Synced and Healthy",
                      file=sys.stderr)
                return 0
            detail = ", ".join(pending[:8])
            if len(pending) > 8:
                detail += f", +{len(pending) - 8} more"
        else:
            detail = f"cannot read Applications: {err}"
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return _refresh_failed(
                "argo-sync", 1, f"still converging after {timeout}s -- {detail}"
            )
        print(f"    still converging: {detail}", file=sys.stderr)
        time.sleep(min(_SYNC_POLL_INTERVAL, remaining))


def cmd_refresh(args: argparse.Namespace) -> int:
    """Land the tracked ref on a persistent deploy now, then re-prove it.

    Argo already tracks the git ref, so the push IS the change and this deploys
    nothing: the hard refresh only decides WHEN the change lands -- now, rather
    than at the next poll. The gate and the smoke suite then judge what came
    back, so "updated" never means "annotated and hoped".
    """
    env = _suite_env(args)
    namespace = args.namespace or env.get("DFE_NAMESPACE", "")
    # Every dfe-namespace suite fails on `namespaces "dfe" not found` without
    # this, so it is refused before anything is annotated.
    if not namespace and not args.skip_verify:
        print(">>> refresh REFUSED: the smoke suite needs the app namespace and none "
              "is known -- pass --env-file (DFE_NAMESPACE) or --namespace. "
              "--skip-verify runs the gate alone, which needs no namespace.",
              file=sys.stderr)
        return 2

    kube = ["kubectl"]
    if args.kubeconfig:
        kube += ["--kubeconfig", args.kubeconfig]

    print(f"\n>>> refresh stage: argo hard-refresh (ns {args.argocd_namespace})",
          file=sys.stderr)
    rc, out, err = _run_text([
        *kube, "-n", args.argocd_namespace, "annotate", "applications.argoproj.io",
        "--all", "argocd.argoproj.io/refresh=hard", "--overwrite",
    ], env=env)
    if rc != 0:
        return _refresh_failed("argo-refresh", rc, _last_line(err) or _last_line(out))
    annotated = len([ln for ln in out.splitlines() if ln.strip()])
    print(f"    {annotated} Application(s) annotated", file=sys.stderr)
    if annotated == 0:
        print(f"    [warn] no Applications in {args.argocd_namespace} -- nothing was "
              "asked to sync; the stages below judge the deploy as it already is",
              file=sys.stderr)

    print(f"\n>>> refresh stage: argo sync (up to {args.readiness_timeout}s)",
          file=sys.stderr)
    repos = _tracked_repos(kube, args.argocd_namespace, env)
    if repos:
        print(f"    tracking {', '.join(repos)}", file=sys.stderr)
    else:
        print("    [warn] no dfe-cluster repo annotations -- waiting on every "
              f"Application in {args.argocd_namespace}", file=sys.stderr)
    rc = _wait_for_sync(kube, args.argocd_namespace, repos,
                        args.readiness_timeout, env)
    if rc != 0:
        return rc

    print(f"\n>>> refresh stage: readiness gate (up to {args.readiness_timeout}s)",
          file=sys.stderr)
    script = _require_script("smoke-test-readiness.sh")
    if script is None:
        return 1
    gate_env = dict(env)
    gate_env["READINESS_TIMEOUT"] = str(args.readiness_timeout)
    # The gate's presence check -- did the deploy produce any workload at all --
    # is the one check it skips when DFE_NS is empty.
    if namespace:
        gate_env["DFE_NS"] = namespace
    else:
        print("    [warn] no namespace (DFE_NAMESPACE or --namespace) -- the gate "
              "cannot tell an empty deploy from a healthy one", file=sys.stderr)
    rc = _run_streaming(["bash", str(script)], env=gate_env)
    if rc != 0:
        return _refresh_failed("readiness", rc)

    if args.skip_verify:
        return _refresh_ok("the deploy is Ready "
                           "(--skip-verify: the smoke suite did not run)")

    print("\n>>> refresh stage: smoke suite", file=sys.stderr)
    rc = cmd_verify(args)
    if rc != 0:
        return _refresh_failed("smoke", rc)
    return _refresh_ok("the deploy is Ready and the smoke suite passed")


# --- acceptance subcommand (the live pytest suite over port-forwards) --------
def _forward(label: str, kube: list[str], namespace: str, target: str,
             local: int, remote: int, stop: threading.Event) -> None:
    """Keep one port-forward alive until the run finishes.

    Supervised rather than started once: a cluster reached through a virtual
    address drops long-lived streams, and a suite that takes minutes outlives
    a single forward.
    """
    cmd = [*kube, "-n", namespace, "port-forward", target, f"{local}:{remote}"]
    while not stop.is_set():
        proc = subprocess.Popen(
            cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        while not stop.is_set() and proc.poll() is None:
            time.sleep(1)
        if proc.poll() is None:
            proc.terminate()
            return
        if not stop.is_set():
            print(f"  forward {label} died, restarting", file=sys.stderr)
            time.sleep(2)


def _forward_ready(url: str, label: str, timeout: float) -> bool:
    """Whether a forwarded endpoint answers at all.

    Any HTTP status counts: the endpoint answering proves the tunnel, and the
    suite judges the response itself.
    """
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=5) as response:
                response.read()
                print(f"  forward {label} ready", file=sys.stderr)
                return True
        except urllib.error.HTTPError:
            print(f"  forward {label} ready (answering)", file=sys.stderr)
            return True
        except OSError:
            time.sleep(2)
    print(f"  forward {label} never became ready: {url}", file=sys.stderr)
    return False


def _secret_value(kube: list[str], namespace: str, name: str, key: str) -> str:
    """One key out of a cluster secret, or empty when it cannot be read."""
    done = subprocess.run(
        [*kube, "-n", namespace, "get", "secret", name, "-o", "json"],
        capture_output=True,
    )
    if done.returncode != 0:
        return ""
    raw = json.loads(done.stdout).get("data", {}).get(key)
    return base64.b64decode(raw).decode("utf-8") if raw else ""


def cmd_acceptance(args: argparse.Namespace) -> int:
    """Run the live acceptance suite against a deployed stack.

    Distinct from `verify`, which wraps the bootstrap smoke tests. This one
    carries the pytest suite in the engine repository over three supervised
    port-forwards -- ingest, the datastore for the assertions, and the engine
    API -- and hands it credentials read from the cluster's own secrets.
    """
    settings = dict(os.environ)
    for env_file in args.env_file:
        loaded = _parse_env_file(env_file)
        settings.update(loaded)
        print(f"  loaded {len(loaded)} var(s) from {env_file}", file=sys.stderr)

    context = args.context or settings.get("DFE_KUBE_CONTEXT")
    namespace = args.namespace or settings.get("DFE_NAMESPACE", "dfe-local")
    ch_namespace = args.ch_namespace or settings.get("DFE_CH_NAMESPACE", "clickhouse")
    ch_secret = args.ch_secret or settings.get("DFE_CH_SECRET", "clickhouse-admin-password")
    server = args.server or settings.get("DFE_KUBE_SERVER")

    kube = ["kubectl"]
    if args.kubeconfig:
        kube += ["--kubeconfig", args.kubeconfig]
    if context:
        kube += ["--context", context]
    # A kubeconfig whose server name does not resolve from here still works
    # when the address is given directly and the certificate covers it.
    if server:
        kube += ["--server", server]

    stop = threading.Event()
    forwards = [
        ("receiver", namespace, args.receiver_target, args.receiver_port, 8080),
        ("datastore", ch_namespace, args.ch_target, args.ch_port, 8123),
        ("engine", namespace, args.engine_target, args.engine_port, 8000),
    ]
    for label, ns, target, local, remote in forwards:
        threading.Thread(
            target=_forward,
            args=(label, kube, ns, target, local, remote, stop),
            daemon=True,
        ).start()

    ready = _forward_ready(f"http://localhost:{args.receiver_port}/livez", "receiver", 90.0)
    ready = _forward_ready(f"http://localhost:{args.ch_port}/ping", "datastore", 90.0) and ready
    # The engine forward only gates the transform class, so a pod mid-roll must
    # degrade that class to a skip rather than fail the whole run.
    engine_up = _forward_ready(f"http://localhost:{args.engine_port}/livez", "engine", 45.0)
    if not ready:
        stop.set()
        print("the suite needs ingest and the datastore; neither is optional", file=sys.stderr)
        return 1

    env = dict(os.environ)
    env.update({
        "DFE_E2E_RECEIVER_URL": f"http://localhost:{args.receiver_port}/ingest",
        "DFE_E2E_CH_HOST": "localhost",
        "DFE_E2E_CH_PORT": str(args.ch_port),
        "DFE_E2E_CH_USER": args.ch_user,
        "DFE_E2E_CH_PASSWORD": _secret_value(kube, namespace, ch_secret, "password"),
        "DFE_E2E_CH_DB": args.ch_database,
    })
    if engine_up:
        env["DFE_E2E_ENGINE_URL"] = f"http://localhost:{args.engine_port}"
    else:
        env.pop("DFE_E2E_ENGINE_URL", None)
        print("  engine forward down: the transform class will skip", file=sys.stderr)

    pytest_args = args.pytest_args or [
        "tests/e2e/test_filebeat_pipeline.py", "-m", "live", "-v",
        "--no-cov", "-p", "no:randomly",
    ]
    done = subprocess.run(
        ["uv", "run", "pytest", *pytest_args], cwd=args.repo, env=env
    )
    stop.set()
    return done.returncode


# --- ui subcommand (the dfe-ui Playwright acceptance specs over port-forwards) -
def _rotate_break_glass(engine_url: str, name: str, current: str) -> str:
    """Rotate the break-glass password through the product API; return the new one.

    In-process on purpose: the token never reaches a command line or a log.
    """
    new_password = secrets.token_urlsafe(24)
    login = urllib.request.Request(
        f"{engine_url}/api/v1/auth/login",
        data=json.dumps({"username": name, "password": current}).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(login, timeout=15) as response:
        token = json.loads(response.read())["access_token"]
    reset = urllib.request.Request(
        f"{engine_url}/api/v1/auth/accounts/{name}/reset-password",
        data=json.dumps({"new_password": new_password}).encode(),
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {token}"},
        method="POST",
    )
    with urllib.request.urlopen(reset, timeout=15) as response:
        response.read()
    return new_password


def cmd_ui(args: argparse.Namespace) -> int:
    """Run the dfe-ui acceptance specs against a deployed stack.

    `acceptance` proves the data path with the engine's pytest suite. This
    drives the UI, which sits on top of the gateway, the engine API, auth and
    the datastore, so one pass exercises all of them.

    The break-glass password is rotated FIRST and the suite gets the new value
    as E2E_ADMIN_PASSWORD (docs/ACCEPTANCE-AUTOMATION.md: the stack under test
    must differ from the build defaults). The bootstrap value it replaces comes
    from DFE_AUTH_LOCAL_ADMIN_PASSWORD in the env file, else the seed default.

    Reach the UI at --ui-url when a gateway serves it. The port-forward is a
    fallback and is announced as one: next-auth builds its callback URLs from
    the deployment's NEXTAUTH_URL, so a localhost origin can refuse the login
    round-trip.
    """
    settings = dict(os.environ)
    for env_file in args.env_file:
        loaded = _parse_env_file(env_file)
        settings.update(loaded)
        print(f"  loaded {len(loaded)} var(s) from {env_file}", file=sys.stderr)

    context = args.context or settings.get("DFE_KUBE_CONTEXT")
    namespace = args.namespace or settings.get("DFE_NAMESPACE", "dfe-local")
    server = args.server or settings.get("DFE_KUBE_SERVER")

    kube = ["kubectl"]
    if args.kubeconfig:
        kube += ["--kubeconfig", args.kubeconfig]
    if context:
        kube += ["--context", context]
    if server:
        kube += ["--server", server]

    stop = threading.Event()
    forwards = [("engine", namespace, args.engine_target, args.engine_port, 8000)]
    if not args.ui_url:
        print(
            "  no --ui-url: forwarding the UI to localhost. next-auth may refuse "
            "the login round-trip on this origin; a gateway URL is the real test.",
            file=sys.stderr,
        )
        forwards.append(("ui", namespace, args.ui_target, args.ui_port, 3000))
    for label, ns, target, local, remote in forwards:
        threading.Thread(
            target=_forward,
            args=(label, kube, ns, target, local, remote, stop),
            daemon=True,
        ).start()

    engine_url = f"http://localhost:{args.engine_port}"
    ui_url = args.ui_url or f"http://localhost:{args.ui_port}"
    ready = _forward_ready(f"{engine_url}/livez", "engine", 90.0)
    ready = _forward_ready(f"{ui_url}/livez", "ui", 90.0) and ready
    if not ready:
        stop.set()
        print("the suite needs the engine and the UI; neither is optional", file=sys.stderr)
        return 1

    admin = settings.get("DFE_AUTH_LOCAL_ADMIN_NAME") or "admin"
    bootstrap = settings.get("DFE_AUTH_LOCAL_ADMIN_PASSWORD") or "changeme"
    if args.no_rotate:
        rotated = bootstrap
        print("  --no-rotate: the suite runs on the bootstrap credential", file=sys.stderr)
    else:
        try:
            rotated = _rotate_break_glass(engine_url, admin, bootstrap)
        except (urllib.error.HTTPError, urllib.error.URLError, KeyError) as exc:
            stop.set()
            print(f"break-glass rotation failed, so the run would prove nothing: {exc}", file=sys.stderr)
            return 1
        print(f"  break-glass '{admin}' rotated for this run", file=sys.stderr)

    env = dict(os.environ)
    env.update({
        "BASE_URL": ui_url,
        "NEXT_PUBLIC_API_URL": engine_url,
        "E2E_ADMIN_PASSWORD": rotated,
        "E2E_BOOTSTRAP_PASSWORD": bootstrap,
        "CI": "1",
    })
    cmd = ["yarn", "playwright", "test", "--grep", args.grep, *args.playwright_args]
    done = subprocess.run(cmd, cwd=Path(args.ui_repo) / "apps" / "dfe-core-ui", env=env)
    stop.set()
    return done.returncode


# --- stack-deploy subcommand (the pinned-stack + mode k8s deploy driver) ------
def _run_text(cmd: list[str], env: dict | None = None) -> tuple[int, str, str]:
    """Run a command capturing text output; return (rc, stdout, stderr).

    Never raises on a non-zero exit -- the caller decides. Explicit utf-8 with
    replacement so a stray non-ASCII byte under LC_ALL=C degrades instead of
    raising UnicodeDecodeError.
    """
    proc = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        env=env,
    )
    return proc.returncode, proc.stdout, proc.stderr


def _last_line(text: str) -> str:
    """Last non-empty line of some command output (for a one-line verdict)."""
    lines = [ln for ln in text.splitlines() if ln.strip()]
    return lines[-1] if lines else ""


def _current_stack() -> str:
    """The versions.yaml `current` pointer (empty if dfe-stack cannot read it)."""
    rc, out, _ = _run_text(["python3", str(DFE_STACK), "current"])
    return out.strip() if rc == 0 else ""


def _parse_env_file(path: str) -> dict[str, str]:
    """Parse a flat KEY=VALUE env file into a dict.

    Handles the ``KEY="value"`` shape of bootstrap/local.env.example (optional
    ``export`` prefix, ``#`` comments, surrounding single/double quotes stripped).
    Deliberately NOT a shell interpreter: no ``$VAR`` expansion or command
    substitution -- it is a pin file, not a script.

    Args:
        path: Path to the env file.

    Returns:
        Mapping of variable name to value.
    """
    out: dict[str, str] = {}
    for raw in Path(path).read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :].lstrip()
        if "=" not in line:
            continue
        key, val = line.split("=", 1)
        key, val = key.strip(), val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            val = val[1:-1]
        out[key] = val
    return out


# --- preflight subcommand (ONLINE, read-only cluster-contract check) ----------
def _parse_cpu(q: str) -> float:
    """Parse a Kubernetes CPU quantity ('4', '3500m', '1500000000n') to cores."""
    q = q.strip()
    if q.endswith("n"):
        return float(q[:-1]) / 1_000_000_000.0
    if q.endswith("u"):
        return float(q[:-1]) / 1_000_000.0
    if q.endswith("m"):
        return float(q[:-1]) / 1000.0
    return float(q)


# BinarySI + DecimalSI suffixes (k8s resource.Quantity). DecimalSI kilo is
# LOWERCASE k; the uppercase forms are kept liberally for hand-written values.
_MEM_SUFFIX = {
    "Ki": 1024,
    "Mi": 1024**2,
    "Gi": 1024**3,
    "Ti": 1024**4,
    "k": 1000,
    "K": 1000,
    "M": 1000**2,
    "G": 1000**3,
    "T": 1000**4,
}


def _parse_mem(q: str) -> int:
    """Parse a Kubernetes memory quantity ('16Gi', '104857600k', '2000000') to bytes."""
    q = q.strip()
    if q.endswith("m"):  # milli-bytes -- rare but a legal Quantity emission
        return int(float(q[:-1]) / 1000)
    for suffix in ("Ki", "Mi", "Gi", "Ti", "k", "K", "M", "G", "T"):
        if q.endswith(suffix):
            return int(float(q[: -len(suffix)]) * _MEM_SUFFIX[suffix])
    return int(float(q))


# Guidance capacity floors per mode -- allocatable across READY nodes. These are
# operating-experience numbers (the 3-node dev cluster runs `scale`
# comfortably), not published minimums: breach -> WARN, never FAIL.
_MODE_CAPACITY = {
    "slim": (2.0, 4 * 1024**3, 1),
    "single": (4.0, 8 * 1024**3, 1),
    "scale": (6.0, 12 * 1024**3, 3),
}

# Cluster-singleton operators bootstrap detect-or-installs. (name, CRD, deploy
# name substring) -- deploy is matched by substring across ALL namespaces
# because an adopted operator may live anywhere.
_ADOPT_OR_INSTALL = (
    ("cert-manager", "certificates.cert-manager.io", "cert-manager"),
    ("external-secrets", "externalsecrets.external-secrets.io", "external-secrets"),
    ("argocd", "applications.argoproj.io", "argocd-repo-server"),
)

# Deployment-name substrings that indicate a LoadBalancer provider exists.
_LB_CONTROLLER_HINTS = ("metallb", "svclb", "cloud-controller", "cilium-operator", "aws-load-balancer")


def _kubectl_json(base: list[str], *argv: str, env: dict | None = None) -> tuple[int, dict, str]:
    """Run kubectl ... -o json and parse. Returns (rc, parsed-or-{}, stderr)."""
    rc, out, err = _run_text([*base, *argv, "-o", "json"], env=env)
    if rc != 0:
        return rc, {}, err.strip()
    try:
        return 0, json.loads(out), ""
    except json.JSONDecodeError as exc:
        return 1, {}, f"unparseable kubectl output: {exc}"


def cmd_preflight(args: argparse.Namespace) -> int:
    """READ-ONLY cluster-contract check: is this cluster right for dfe-infra?

    The product rule is "assume a vanilla Rancher/RKE2 cluster and BRING what
    the stack needs" -- so this does not demand pre-installed operators; it
    verifies the things bootstrap cannot fix (API access, RBAC, nodes,
    scheduling labels) and PREVIEWS the decisions bootstrap will take
    (adopt-or-install, storage fallback). Creates and changes NOTHING.
    Documented in docs/TESTING-CYCLE.md (the cluster contract).
    """
    # --from-terraform then --env-file fill defaults the flags did not set
    # (same precedence as stack-deploy's _assemble_env: terraform < env-file).
    file_env: dict[str, str] = {}
    if args.from_terraform:
        sys.path.insert(0, str(BOOTSTRAP))
        from bridge import get_tf_outputs

        file_env.update({k: v for k, v in get_tf_outputs(args.from_terraform).items() if k.startswith("DFE_")})
    for env_file in args.env_file:
        file_env.update(_parse_env_file(env_file))
    namespace = args.namespace or file_env.get("DFE_NAMESPACE") or "dfe-local"
    storage_class = args.storage_class or file_env.get("DFE_STORAGE_CLASS") or ""
    context = args.context or file_env.get("DFE_KUBE_CONTEXT") or ""

    base = ["kubectl"]
    if args.kubeconfig:
        base += ["--kubeconfig", args.kubeconfig]
    if context:
        base += ["--context", context]

    fails: list[str] = []
    warns: list[str] = []

    def ok(msg: str) -> None:
        print(f"  [ok]   {msg}", file=sys.stderr)

    def warn(msg: str) -> None:
        warns.append(msg)
        print(f"  [warn] {msg}", file=sys.stderr)

    def fail(msg: str) -> None:
        fails.append(msg)
        print(f"  [FAIL] {msg}", file=sys.stderr)

    print(
        f"=== cluster preflight (READ-ONLY) mode={args.mode} "
        f"context={context or '(current)'} namespace={namespace} ===",
        file=sys.stderr,
    )

    if shutil.which("kubectl") is None:
        print("  [FAIL] kubectl not on PATH", file=sys.stderr)
        return 1

    # 1. API reachable + server version.
    rc, ver, err = _kubectl_json(base, "version")
    if rc != 0:
        fail(f"API server unreachable: {err or 'kubectl version failed'}")
        print("=== PREFLIGHT FAILED (cannot reach the cluster) ===", file=sys.stderr)
        return 1
    server = ver.get("serverVersion", {})
    git_version = server.get("gitVersion", "?")
    try:
        sv = (int(server.get("major", "0")), int(server.get("minor", "0").rstrip("+")))
    except ValueError:
        sv = (0, 0)
    try:
        floor = tuple(int(p.rstrip("+")) for p in args.min_k8s.split("."))
    except ValueError:
        print(f"  [FAIL] --min-k8s {args.min_k8s!r} is not a version (want e.g. 1.28)", file=sys.stderr)
        return 2
    if sv >= floor:
        ok(f"API server {git_version} (>= {args.min_k8s})")
    else:
        fail(f"API server {git_version} is below the supported floor {args.min_k8s}")
    if "+rke2" in git_version:
        ok("RKE2 distribution detected (the on-prem baseline)")

    # 2. Nodes: Ready, capacity, and the workload-label trap.
    rc, nodes_json, err = _kubectl_json(base, "get", "nodes")
    nodes = nodes_json.get("items", [])
    if rc != 0 or not nodes:
        fail(f"cannot list nodes: {err or 'no nodes returned'}")
        print("=== PREFLIGHT FAILED ===", file=sys.stderr)
        return 1
    ready_nodes = [
        n
        for n in nodes
        if any(
            c.get("type") == "Ready" and c.get("status") == "True"
            for c in n.get("status", {}).get("conditions", [])
        )
    ]
    if not ready_nodes:
        fail(f"0 of {len(nodes)} nodes Ready")
    else:
        ok(f"{len(ready_nodes)}/{len(nodes)} nodes Ready")
    # Capacity is guidance, so a Quantity form the parsers do not know must
    # degrade to a warning -- never a traceback in a tool that promises a
    # verdict for every check.
    try:
        cpu = sum(_parse_cpu(n["status"]["allocatable"].get("cpu", "0")) for n in ready_nodes)
        mem = sum(_parse_mem(n["status"]["allocatable"].get("memory", "0")) for n in ready_nodes)
    except ValueError as exc:
        warn(f"could not parse node allocatable quantities ({exc}) -- capacity check skipped")
    else:
        min_cpu, min_mem, min_nodes = _MODE_CAPACITY[args.mode]
        cap = f"allocatable {cpu:.1f} CPU / {mem / 1024**3:.1f}Gi across {len(ready_nodes)} Ready node(s)"
        if cpu >= min_cpu and mem >= min_mem and len(ready_nodes) >= min_nodes:
            ok(f"{cap} (guidance floor for {args.mode}: {min_cpu:.0f} CPU / {min_mem / 1024**3:.0f}Gi / {min_nodes} node(s))")
        else:
            warn(
                f"{cap} is under the {args.mode} guidance floor "
                f"({min_cpu:.0f} CPU / {min_mem / 1024**3:.0f}Gi / {min_nodes} node(s)) -- expect scheduling pressure"
            )
    for pair in args.require_label:
        if "=" not in pair:
            fail(f"--require-label {pair!r} is not KEY=VALUE")
            continue
        key, val = pair.split("=", 1)
        matching = [n for n in ready_nodes if n.get("metadata", {}).get("labels", {}).get(key) == val]
        if matching:
            ok(f"{len(matching)} Ready node(s) carry {key}={val}")
        else:
            fail(
                f"NO Ready node carries {key}={val} -- every pod selecting on it will sit "
                "Pending forever with 'didn't match Pod's node affinity/selector'. "
                "Wrong cluster, or the label was never applied."
            )

    # 3. Storage: a default StorageClass, a named one, or bootstrap's fallback.
    rc, sc_json, err = _kubectl_json(base, "get", "storageclass")
    scs = sc_json.get("items", []) if rc == 0 else []
    sc_names = [s.get("metadata", {}).get("name", "?") for s in scs]
    default_scs = [
        s.get("metadata", {}).get("name", "?")
        for s in scs
        if s.get("metadata", {}).get("annotations", {}).get("storageclass.kubernetes.io/is-default-class") == "true"
    ]
    if storage_class:
        if storage_class in sc_names:
            ok(f"named StorageClass {storage_class!r} exists")
        elif storage_class == "local-path" and not sc_names:
            ok(f"StorageClass {storage_class!r} absent -- bootstrap detect-or-installs local-path-provisioner")
        else:
            fail(f"StorageClass {storage_class!r} not found (have: {', '.join(sc_names) or 'none'})")
    elif default_scs:
        ok(f"default StorageClass: {default_scs[0]}")
    else:
        warn("no default StorageClass -- bootstrap will install local-path-provisioner (fine on-prem; on a cloud target set DFE_STORAGE_CLASS)")

    # 4 + 5. One deploy sweep serves the LB heuristic and adopt-or-install.
    rc, deploys_json, _ = _kubectl_json(base, "get", "deployments", "-A")
    deploy_names = [d.get("metadata", {}).get("name", "") for d in deploys_json.get("items", [])] if rc == 0 else []

    rc, svc_json, _ = _kubectl_json(base, "get", "services", "-A")
    lb_live = [
        s.get("metadata", {}).get("name", "?")
        for s in svc_json.get("items", [])
        if s.get("spec", {}).get("type") == "LoadBalancer" and s.get("status", {}).get("loadBalancer", {}).get("ingress")
    ] if rc == 0 else []
    lb_ctrl = [n for n in deploy_names if any(h in n for h in _LB_CONTROLLER_HINTS)]
    if lb_live:
        ok(f"LoadBalancer provider working ({len(lb_live)} Service(s) hold an address)")
    elif lb_ctrl:
        ok(f"LoadBalancer controller present: {lb_ctrl[0]}")
    else:
        warn("no LoadBalancer provider detected -- bootstrap installs MetalLB on-prem; on a cloud target the cloud LB controller must exist")

    # 5. Adopt-or-install preview (mirrors bootstrap's dfe_should_install).
    rc, crd_json, err = _kubectl_json(base, "get", "crd")
    crd_names = {c.get("metadata", {}).get("name", "") for c in crd_json.get("items", [])} if rc == 0 else set()
    if rc != 0:
        warn(f"cannot list CRDs ({err}) -- adopt-or-install preview skipped")
    else:
        for name, crd, deploy_hint in _ADOPT_OR_INSTALL:
            has_crd = crd in crd_names
            has_deploy = any(deploy_hint in d for d in deploy_names)
            if has_crd and has_deploy:
                ok(f"{name}: present -> bootstrap ADOPTS the existing operator")
            elif has_crd:
                warn(f"{name}: CRD {crd} present but no running operator (lingering CRD) -> bootstrap re-adopts + INSTALLS")
            else:
                ok(f"{name}: absent -> bootstrap INSTALLS DFE-owned")

    # 6. RBAC: the verbs bootstrap needs. can-i is a SelfSubjectAccessReview --
    # read-only against the cluster.
    for verb, resource, extra in (
        ("create", "namespaces", []),
        ("create", "customresourcedefinitions", []),
        ("create", "clusterroles", []),
        ("create", "deployments", ["-n", namespace]),
        ("create", "secrets", ["-n", namespace]),
    ):
        rc, out, _err = _run_text([*base, "auth", "can-i", verb, resource, *extra])
        scope = f" (ns {namespace})" if extra else ""
        if rc == 0 and out.strip() == "yes":
            ok(f"can {verb} {resource}{scope}")
        else:
            fail(f"cannot {verb} {resource}{scope} -- bootstrap needs it")

    # 7. Registry reachability FROM THIS MACHINE (the in-cluster path can still
    # differ -- an air-gapped cluster fails pulls even when this passes).
    registry_host = args.registry.split("/")[0]
    try:
        req = urllib.request.Request(f"https://{registry_host}/v2/", method="GET")
        with urllib.request.urlopen(req, timeout=10) as resp:
            ok(f"registry {registry_host} reachable from here (HTTP {resp.status})")
    except urllib.error.HTTPError as exc:
        # 401 IS reachable -- /v2/ demands auth by design.
        ok(f"registry {registry_host} reachable from here (HTTP {exc.code})")
    except (urllib.error.URLError, OSError) as exc:
        warn(f"registry {registry_host} unreachable from this machine ({exc}) -- verify the CLUSTER can pull before deploying")

    hard = len(fails)
    if args.strict and warns:
        fails.extend(warns)
    if fails:
        print(f"=== PREFLIGHT FAILED ({hard} blocking issue(s), {len(warns)} warning(s){' [--strict]' if args.strict and warns else ''}) ===", file=sys.stderr)
        return 1
    print(f"=== PREFLIGHT PASSED ({len(warns)} warning(s)) -- cluster meets the dfe-infra contract ===", file=sys.stderr)
    return 0


def _offline_preflight(args: argparse.Namespace) -> int:
    """Offline, cluster-free gate before any deploy.

    Proves the four things that can be checked without a cluster: the stack pins
    resolve, the working tree has not drifted from the SSoT, the interdependency
    constraints hold, and the mode's charts actually render at the pinned
    versions. Returns 0 on pass, 1 on a hard failure.
    """
    print(
        "=== stack-deploy PRE-FLIGHT (offline; no cluster contacted) ===",
        file=sys.stderr,
    )
    hard_fail = 0

    # 1. Stack pins resolve (and are the real, published set).
    rc, out, err = _run_text(
        ["python3", str(DFE_STACK), "--registry", args.registry, "render", "--stack", args.stack]
    )
    if rc != 0:
        print(f"  [FAIL] stack {args.stack!r} does not resolve: {err.strip() or _last_line(out)}", file=sys.stderr)
        return 1
    published = [ln for ln in out.splitlines() if ln.strip().startswith("dfe-") and "@sha256:" in ln]
    print(f"  [ok]   stack {args.stack}: pins resolve ({len(published)} published app image(s))", file=sys.stderr)

    # 2. Drift-check -- working-tree pins == versions.yaml. Validates `current`
    #    only, so warn (do not fail) when a non-current stack is requested.
    rc, out, err = _run_text(["python3", str(DRIFT_CHECK)])
    if rc != 0:
        print("  [FAIL] version drift vs versions.yaml (SSoT):", file=sys.stderr)
        print((out or err).rstrip(), file=sys.stderr)
        hard_fail += 1
    else:
        print(f"  [ok]   {_last_line(out) or 'no version drift'}", file=sys.stderr)
    current = _current_stack()
    if current and args.stack != current:
        print(
            f"  [warn] --stack {args.stack} != versions.yaml current ({current}); the "
            "drift-check validates `current` only -- deploy from the matching git revision.",
            file=sys.stderr,
        )

    # 3. Namespace drift -- the operator-namespace SSoT vs where the appsets
    #    install each operator. A selector naming an absent namespace matches
    #    nothing and raises no error, so nothing else catches this (#136).
    rc, out, err = _run_text(["python3", str(NAMESPACE_DRIFT_CHECK)])
    if rc != 0:
        print("  [FAIL] operator-namespace drift vs common.yaml (SSoT):", file=sys.stderr)
        print((out or err).rstrip(), file=sys.stderr)
        hard_fail += 1
    else:
        print(f"  [ok]   {_last_line(out) or 'no namespace drift'}", file=sys.stderr)

    # 4. Compat-check -- the stack's interdependency locks.
    compat_cmd = ["python3", str(DFE_STACK), "compat-check", "--stack", args.stack]
    if args.strict_compat:
        compat_cmd.append("--strict")
    rc, out, err = _run_text(compat_cmd)
    tag = "ok" if rc == 0 else "FAIL"
    print(f"  [{tag}]   compat-check: {_last_line(out) or _last_line(err)}", file=sys.stderr)
    if rc != 0 and args.strict_compat:
        hard_fail += 1

    # 5. Render the mode's charts at the pinned versions (catch a broken profile
    #    offline). helm optional -- a missing binary warns, it does not fail.
    if shutil.which("helm") is None:
        print("  [warn] helm not on PATH -- skipping the chart-render pre-flight.", file=sys.stderr)
    else:
        common = ARGO_VALUES / "common.yaml"
        profile = ARGO_VALUES / f"profile-{args.mode}.yaml"
        # appNamespace is an estate value the appset supplies at deploy from the
        # cluster's dfe.hyperi.io/dfe_namespace annotation; scale's kafka chart
        # fail-fasts without it (fromSecretsStore needs a target namespace to
        # project the credential into). Offline there is no annotation, so feed a
        # synthetic one -- this is a structural render check, the output is
        # discarded, and the fail-fast still guards real deploys.
        for chart in (*_MODE_SUBSTRATE[args.mode], *_PREFLIGHT_APPS):
            tmp = tempfile.mkdtemp(prefix=f"dfe-render-{chart}-")
            try:
                rc, _out, err = _run_text(
                    [
                        "helm", "template", chart, str(HELM_CHARTS / chart),
                        "-f", str(common), "-f", str(profile),
                        "--set", "appNamespace=preflight",
                        "--output-dir", tmp,
                    ]
                )
            finally:
                shutil.rmtree(tmp, ignore_errors=True)
            if rc != 0:
                print(f"  [FAIL] helm render {chart} ({args.mode}): {_last_line(err)}", file=sys.stderr)
                hard_fail += 1
            else:
                print(f"  [ok]   helm render {chart} ({args.mode})", file=sys.stderr)

    if hard_fail:
        print(f"=== PRE-FLIGHT FAILED ({hard_fail} issue(s)) -- fix before deploying ===", file=sys.stderr)
        return 1
    print("=== PRE-FLIGHT PASSED ===", file=sys.stderr)
    return 0


def _assemble_env(args: argparse.Namespace) -> dict[str, str]:
    """Build the bootstrap environment: os.environ < terraform < env-file < forced.

    The forced overrides are the whole point of the driver: DFE_PROFILE = the
    chosen mode (the single lever that selects the deploy profile end to end) and,
    optionally, the Argo git ref for the pinned charts. Later sources win, so a
    terraform-supplied DFE_PROFILE (one of slim|single|scale) is always replaced
    by the requested mode.
    """
    env = dict(os.environ)

    if args.from_terraform:
        # Reuse bridge.py's tested terraform-output reader (handles sensitive
        # outputs) rather than re-implementing it.
        sys.path.insert(0, str(BOOTSTRAP))
        from bridge import get_tf_outputs

        tf = get_tf_outputs(args.from_terraform)
        dfe = {k: v for k, v in tf.items() if k.startswith("DFE_")}
        env.update(dfe)
        print(f"  loaded {len(dfe)} DFE_* var(s) from terraform {args.from_terraform}", file=sys.stderr)

    for env_file in args.env_file:
        loaded = _parse_env_file(env_file)
        env.update(loaded)
        print(f"  loaded {len(loaded)} var(s) from {env_file}", file=sys.stderr)

    env["DFE_PROFILE"] = args.mode
    if args.target_revision:
        env["DFE_TARGET_REVISION"] = args.target_revision
    if args.kubeconfig:
        env["KUBECONFIG"] = args.kubeconfig
    env["READINESS_TIMEOUT"] = str(args.readiness_timeout)
    env["DFE_ACCESS_OUT"] = args.access_out
    if args.skip_e2e:
        env["DFE_SKIP_INTEGRATION_TESTS"] = "true"
    if args.dry_run:
        env["DFE_DRY_RUN"] = "true"
    return env


def cmd_stack_deploy(args: argparse.Namespace) -> int:
    """Drive a pinned-stack, mode-selected deploy + the two default E2E tests."""
    if args.mode not in MODES:
        print(f"--mode must be one of {', '.join(MODES)}", file=sys.stderr)
        return 2

    if _offline_preflight(args) != 0:
        return 1
    if args.check_only:
        print("check-only: pre-flight passed; no cluster changes made.", file=sys.stderr)
        return 0

    env = _assemble_env(args)

    # Fail early on incomplete env -- clearer than a mid-bootstrap abort.
    missing = [v for v in BOOTSTRAP_REQUIRED if not env.get(v)]
    if missing:
        print(f"ERROR: missing required deploy env: {', '.join(missing)}", file=sys.stderr)
        print(
            "Supply them via --from-terraform <dir> or --env-file <file> "
            "(see bootstrap/local.env.example).",
            file=sys.stderr,
        )
        return 1
    if args.kubeconfig and not Path(args.kubeconfig).is_file():
        print(
            f"ERROR: --kubeconfig {args.kubeconfig} not found "
            "(fetch it first: dfe-ops kubeconfig ...).",
            file=sys.stderr,
        )
        return 1

    script = _require_script("bootstrap.sh")
    if script is None:
        return 1

    print("", file=sys.stderr)
    print("=== stack-deploy ===", file=sys.stderr)
    print(f"  Stack:      {args.stack}", file=sys.stderr)
    print(f"  Mode:       {args.mode} (DFE_PROFILE={env['DFE_PROFILE']})", file=sys.stderr)
    print(f"  Namespace:  {env.get('DFE_NAMESPACE')}", file=sys.stderr)
    print(f"  Cloud/env:  {env.get('DFE_CLOUD')}/{env.get('DFE_ENV')}", file=sys.stderr)
    print(f"  Git ref:    {env.get('DFE_TARGET_REVISION')}", file=sys.stderr)
    print(f"  Kubeconfig: {env.get('KUBECONFIG', '(current context)')}", file=sys.stderr)
    print(f"  Readiness:  bounded at {env['READINESS_TIMEOUT']}s", file=sys.stderr)
    print(f"  E2E tests:  {'SKIPPED' if args.skip_e2e else 'ON (data path + self-monitoring)'}", file=sys.stderr)
    print(f"  Dry run:    {'yes (no cluster changes)' if args.dry_run else 'no'}", file=sys.stderr)
    print("", file=sys.stderr)

    rc = _run_streaming(["bash", str(script)], env=env)
    if rc != 0:
        print(
            "\n=== stack-deploy FAILED -- bootstrap / readiness gate / E2E did not "
            "pass (see the failures above). ===",
            file=sys.stderr,
        )
        return rc
    print("\n=== stack-deploy OK ===", file=sys.stderr)
    print(
        "  Layer 0/1 up, Argo synced the mode profile at the pinned versions, "
        "readiness gate passed.",
        file=sys.stderr,
    )
    if not args.skip_e2e:
        print("  Two default E2E tests passed (receiver->CH data path + self-monitoring OTel).", file=sys.stderr)
    print(f"  Access summary written to: {args.access_out}", file=sys.stderr)
    return 0


# --- cycle subcommand (the repeat create -> test e2e -> destroy loop) ---------
def cmd_cycle(args: argparse.Namespace) -> int:
    """THE validation cycle this repo owns: preflight -> deploy+E2E -> smoke -> destroy.

    Each stage self-executes as its own dfe-ops subcommand, so a stage run by
    the cycle is EXACTLY the stage a human runs by hand -- no drift between
    "the cycle" and "the commands". The one thing the cycle adds on top is
    target pinning: --kubeconfig is exported as KUBECONFIG to EVERY stage,
    because verify/teardown are ambient-context tools and a mixed-target
    cycle would smoke-test one cluster and destroy another.
    Documented in docs/TESTING-CYCLE.md.

    Destroy runs by default (an ephemeral test deployment must die with the
    cycle -- non-negotiable for cloud targets); --keep skips it for
    interactive debugging on a dev cluster. A FAILED deploy still destroys,
    so a broken run never strands a half-stack.
    """
    self_cmd = [sys.executable, str(Path(__file__).resolve())]
    passthrough_kube = ["--kubeconfig", args.kubeconfig] if args.kubeconfig else []
    passthrough_env = [flag for f in args.env_file for flag in ("--env-file", f)]

    # EVERY stage must aim at the SAME cluster. verify/teardown wrap shell
    # scripts that use the ambient context, so --kubeconfig alone would leave
    # the smoke suite validating -- and the FORCED destroy wiping -- whatever
    # cluster the operator's current context happens to point at (the exact
    # wrong-cluster trap preflight exists to catch). Exporting KUBECONFIG to
    # every child pins all four stages to the target.
    stage_env = dict(os.environ)
    if args.kubeconfig:
        if not Path(args.kubeconfig).is_file():
            print(f"ERROR: --kubeconfig {args.kubeconfig} not found", file=sys.stderr)
            return 1
        stage_env["KUBECONFIG"] = str(Path(args.kubeconfig).resolve())

    stages: list[tuple[str, list[str]]] = []
    if not args.skip_preflight:
        preflight_cmd = [
            *self_cmd, "preflight", "--mode", args.mode,
            *passthrough_kube, *passthrough_env,
            "--registry", args.registry.split("/")[0],
        ]
        if args.from_terraform:
            preflight_cmd += ["--from-terraform", args.from_terraform]
        for pair in args.require_label:
            preflight_cmd += ["--require-label", pair]
        stages.append(("preflight", preflight_cmd))

    deploy_cmd = [
        *self_cmd, "stack-deploy", "--mode", args.mode, "--stack", args.stack,
        "--registry", args.registry,
        *passthrough_kube, *passthrough_env,
    ]
    if args.from_terraform:
        deploy_cmd += ["--from-terraform", args.from_terraform]
    if args.target_revision:
        deploy_cmd += ["--target-revision", args.target_revision]
    stages.append(("deploy+e2e", deploy_cmd))
    # The smoke stage needs the deploy's env too, not just its cluster: the
    # namespaces it checks come from those same sources.
    smoke_cmd = [*self_cmd, "verify", "--mode", args.mode,
                 *passthrough_kube, *passthrough_env]
    if args.from_terraform:
        smoke_cmd += ["--from-terraform", args.from_terraform]
    stages.append(("smoke", smoke_cmd))
    # The UI stage is opt-in: it needs a dfe-ui checkout and node, which not
    # every cycle runner has, and a cycle that starts failing for want of a
    # browser would be worse than one that says the stage did not run.
    if args.ui_repo:
        ui_cmd = [*self_cmd, "ui", "--ui-repo", args.ui_repo,
                  *passthrough_kube, *passthrough_env]
        if args.ui_url:
            ui_cmd += ["--ui-url", args.ui_url]
        stages.append(("ui", ui_cmd))

    results: list[tuple[str, int, float]] = []
    aborted = False
    for name, cmd in stages:
        print(f"\n=== cycle stage: {name} ===", file=sys.stderr)
        started = time.monotonic()
        rc = _run_streaming(cmd, env=stage_env)
        results.append((name, rc, time.monotonic() - started))
        if rc != 0:
            aborted = True
            print(f"=== cycle stage {name} FAILED (rc {rc}) -- skipping later test stages ===", file=sys.stderr)
            break

    # Destroy is NOT skipped on failure -- an aborted cycle must not strand a
    # half-deployed stack (and a cloud target must never outlive its test).
    # A terraform-provisioned target also destroys its IaC state: the on-cluster
    # teardown alone would leave the control plane + nodes running (and
    # billing), which breaks the ephemeral-cloud rule.
    if args.keep:
        print("\n--keep: leaving the deployment up (destroy it yourself: dfe-ops teardown).", file=sys.stderr)
    else:
        print("\n=== cycle stage: destroy ===", file=sys.stderr)
        teardown_cmd = [*self_cmd, "teardown", "--force"]
        if args.from_terraform:
            teardown_cmd += ["--with-terraform", "--tf-dir", args.from_terraform]
        started = time.monotonic()
        rc = _run_streaming(teardown_cmd, env=stage_env)
        results.append(("destroy", rc, time.monotonic() - started))
        if rc != 0:
            aborted = True

    print("\n=== cycle summary ===", file=sys.stderr)
    for name, rc, secs in results:
        verdict = "ok" if rc == 0 else f"FAILED rc={rc}"
        print(f"  {name:<10} {verdict:<12} {secs:7.1f}s", file=sys.stderr)
    skipped = [name for name, _ in stages if name not in {r[0] for r in results}]
    for name in skipped:
        print(f"  {name:<10} skipped", file=sys.stderr)
    overall = 1 if aborted or any(rc != 0 for _, rc, _ in results) else 0
    print(f"=== cycle {'FAILED' if overall else 'PASSED'} ===", file=sys.stderr)
    return overall


# --- parser ------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="dfe-ops",
        description="One CLI for DFE cluster operations (generic, any cluster).",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    sub = ap.add_subparsers(dest="command", required=True, metavar="<subcommand>")

    # kubeconfig
    kc = sub.add_parser(
        "kubeconfig",
        help="fetch a node's kubeconfig via a Vault/OpenBao-stored SSH key",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    kc.add_argument("--node", required=True, help="node host/IP to SSH to (the API server node)")
    kc.add_argument("--user", default=DEFAULT_USER, help="SSH user")
    kc.add_argument("--vault-path", default=DEFAULT_VAULT_PATH, help="Vault/OpenBao kv path of the SSH key")
    kc.add_argument("--vault-field", default=DEFAULT_VAULT_FIELD, help="field holding the base64 private key")
    kc.add_argument("--vault-cmd", default=DEFAULT_VAULT_CMD, help="secrets CLI: bao or vault")
    kc.add_argument("--remote-path", default=DEFAULT_REMOTE_PATH, help="kubeconfig path on the node")
    kc.add_argument("--server", default=None, help="rewrite the API server to this URL (default: https://<node>:6443)")
    kc.add_argument("--out", default="kubeconfig", help="local output kubeconfig path")
    kc.set_defaults(func=cmd_kubeconfig)

    # probe
    pr = sub.add_parser(
        "probe",
        help="minimal curl-equivalent HTTP client (stdlib only)",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    pr.add_argument("method", help="HTTP method (GET, POST, PUT, DELETE, ...)")
    pr.add_argument("url", help="request URL")
    pr.add_argument("-H", "--header", action="append", default=[], metavar="'K: V'", help="request header (repeatable)")
    pr.add_argument("-d", "--data", default=None, help="raw request body")
    pr.add_argument("--json", default=None, help="JSON request body (also sets Content-Type: application/json)")
    pr.add_argument("-k", "--insecure", action="store_true", help="skip TLS certificate verification")
    pr.add_argument("--timeout", type=float, default=15.0, help="timeout (seconds)")
    pr.add_argument("--head", action="store_true", help="print response headers too")
    pr.add_argument("--fail", action="store_true", help="exit non-zero on HTTP status >= 400")
    pr.set_defaults(func=cmd_probe)

    # deploy-values
    dv = sub.add_parser(
        "deploy-values",
        help="get/put/delete a values file in the bundled deploy repo (Gitea-family API)",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    dv.add_argument("action", choices=["get", "put", "delete"], help="operation")
    dv.add_argument("path", help="file path inside the repo, e.g. values/foo-values.yaml")
    dv.add_argument("--file", default=None, help="local file with the content (put)")
    dv.add_argument("--url", default="http://localhost:13000", help="deploy-repo git host base URL (e.g. the Forgejo port-forward)")
    dv.add_argument("--repo", default="deploy", help="repository name")
    dv.add_argument("--owner", default=None, help="repository owner (default: the admin user)")
    dv.add_argument("--kubeconfig", default=None, help="kubeconfig for the credential read (default: ambient)")
    dv.add_argument("--secret-namespace", default="forgejo", help="namespace of the admin Secret")
    dv.add_argument("--secret", default="dfe-forgejo-admin", help="admin Secret name (keys: username, password)")
    dv.add_argument("-m", "--message", default=None, help="commit message")
    dv.add_argument("--timeout", type=float, default=15.0, help="timeout (seconds)")
    dv.set_defaults(func=cmd_deploy_values)

    # deploy
    dp = sub.add_parser(
        "deploy",
        help="deploy DFE to a target cloud (wraps bootstrap/deploy.sh)",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    dp.add_argument("--cloud", default="local", help="target cloud: local, aws, gcp, az")
    dp.add_argument("--tf-dir", default=None, help="terraform env dir (default: auto from --cloud)")
    dp.add_argument("--dry-run", action="store_true", help="show what would happen without executing")
    dp.add_argument("--skip-terraform", action="store_true", help="skip terraform apply (use existing state)")
    dp.set_defaults(func=cmd_deploy)

    # stack-deploy
    sd = sub.add_parser(
        "stack-deploy",
        help="deploy a pinned stack version in a mode (slim|single|scale) + run the 2 default E2E tests",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    sd.add_argument("--stack", default=DEFAULT_STACK, help="versions.yaml stack version to deploy/validate")
    sd.add_argument(
        "--mode",
        required=True,
        choices=list(MODES),
        help="deploy profile: slim (gRPC, no Kafka), single (1 node + Kafka), scale (HA + operators)",
    )
    sd.add_argument(
        "--kubeconfig",
        default=os.environ.get("KUBECONFIG"),
        help="kubeconfig for the target cluster (default: $KUBECONFIG / current context)",
    )
    sd.add_argument(
        "--env-file",
        action="append",
        default=[],
        metavar="PATH",
        help="DFE_* env file for secrets/endpoints (repeatable; later wins). See bootstrap/local.env.example",
    )
    sd.add_argument(
        "--from-terraform",
        default=None,
        metavar="DIR",
        help="read DFE_* outputs from a terraform env dir (terraform apply is a prereq)",
    )
    sd.add_argument(
        "--target-revision",
        default=None,
        help="Argo git ref for the pinned charts (overrides DFE_TARGET_REVISION)",
    )
    sd.add_argument(
        "--readiness-timeout",
        type=int,
        default=900,
        help="bounded readiness wait in seconds (never wait-forever; sets READINESS_TIMEOUT)",
    )
    sd.add_argument("--registry", default=DEFAULT_REGISTRY, help="image registry prefix (passthrough to dfe-stack)")
    sd.add_argument("--access-out", default="dfe-access.md", help="where the post-deploy access summary is written")
    sd.add_argument("--strict-compat", action="store_true", help="fail if compat-check reports an error-severity violation")
    sd.add_argument("--skip-e2e", action="store_true", help="skip the two default E2E tests (NOT recommended)")
    sd.add_argument("--check-only", action="store_true", help="run only the offline pre-flight, then stop (no cluster changes)")
    sd.add_argument("--dry-run", action="store_true", help="pre-flight + bootstrap in DFE_DRY_RUN mode (prints commands, no apply)")
    sd.set_defaults(func=cmd_stack_deploy)

    # preflight
    pf = sub.add_parser(
        "preflight",
        help="READ-ONLY check: is this cluster right for a DFE deployment?",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    pf.add_argument("--mode", default="single", choices=list(MODES), help="deploy profile the cluster is being sized for")
    pf.add_argument("--kubeconfig", default=os.environ.get("KUBECONFIG"), help="kubeconfig for the target cluster (default: $KUBECONFIG / current context)")
    pf.add_argument("--context", default=None, help="kubeconfig context name (default: DFE_KUBE_CONTEXT from --env-file, else current)")
    pf.add_argument("--namespace", default=None, help="target app namespace (default: DFE_NAMESPACE from --env-file, else dfe-local)")
    pf.add_argument("--storage-class", default=None, help="named StorageClass to require (default: DFE_STORAGE_CLASS from --env-file, else any default SC)")
    pf.add_argument("--env-file", action="append", default=[], metavar="PATH", help="DFE_* env file supplying defaults (repeatable; later wins)")
    pf.add_argument("--from-terraform", default=None, metavar="DIR", help="read DFE_* defaults from a terraform env dir (env files win over it)")
    pf.add_argument("--require-label", action="append", default=[], metavar="KEY=VALUE", help="a node label Ready workers MUST carry (repeatable) -- catches the wrong-cluster trap")
    pf.add_argument("--registry", default="ghcr.io", help="registry HOST to check reachability of (from this machine)")
    pf.add_argument("--min-k8s", default="1.28", help="minimum Kubernetes server version (guidance floor)")
    pf.add_argument("--strict", action="store_true", help="treat warnings as failures")
    pf.set_defaults(func=cmd_preflight)

    # cycle
    cy = sub.add_parser(
        "cycle",
        help="THE validation cycle: preflight -> stack-deploy+E2E -> smoke suite -> destroy",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    cy.add_argument("--mode", required=True, choices=list(MODES), help="deploy profile to cycle")
    cy.add_argument("--stack", default=DEFAULT_STACK, help="versions.yaml stack version to deploy")
    cy.add_argument("--kubeconfig", default=os.environ.get("KUBECONFIG"), help="kubeconfig for the target cluster")
    cy.add_argument("--env-file", action="append", default=[], metavar="PATH", help="DFE_* env file (repeatable; later wins) -- the ONLY place estate-specific values live")
    cy.add_argument("--from-terraform", default=None, metavar="DIR", help="read DFE_* outputs from a terraform env dir")
    cy.add_argument("--target-revision", default=None, help="Argo git ref for the pinned charts")
    cy.add_argument("--registry", default=DEFAULT_REGISTRY, help="image registry prefix")
    cy.add_argument("--require-label", action="append", default=[], metavar="KEY=VALUE", help="node label the preflight must find (repeatable)")
    cy.add_argument("--skip-preflight", action="store_true", help="skip the online cluster preflight stage")
    cy.add_argument("--keep", action="store_true", help="do NOT destroy at the end (dev-cluster debugging only; cloud cycles must destroy)")
    cy.add_argument("--ui-repo", default=None, metavar="DIR",
                    help="dfe-ui checkout; given, the ui stage runs after smoke (needs node + a browser)")
    cy.add_argument("--ui-url", default=None,
                    help="the gateway URL the UI is served on; without it the ui stage port-forwards and says so")
    cy.set_defaults(func=cmd_cycle)

    # teardown
    td = sub.add_parser(
        "teardown",
        help="tear the deployment down (wraps bootstrap/destroy.sh)",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    td.add_argument("--force", action="store_true", help="skip the confirmation prompt")
    td.add_argument("--dry-run", action="store_true", help="show what would be deleted without deleting")
    td.add_argument("--with-terraform", action="store_true", help="also destroy terraform state (OpenBao KV + AppRoles)")
    td.add_argument("--cloud", default="local", help="terraform env for --with-terraform")
    td.add_argument("--tf-dir", default=None, help="terraform env dir for --with-terraform (default: auto from --cloud)")
    # OpenTofu is the house IaC tool; plain terraform is the retiring fallback.
    td.add_argument(
        "--tf-bin",
        default=("tofu" if shutil.which("tofu") else "terraform"),
        help="IaC binary for --with-terraform (auto: tofu if on PATH, else terraform)",
    )
    td.set_defaults(func=cmd_teardown)

    # verify
    vf = sub.add_parser(
        "verify",
        help="run the smoke-test suite (wraps bootstrap/run-all-smoke-tests.sh)",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    vf.add_argument("--readiness-only", action="store_true", help="run only the readiness gate (pods Ready)")
    vf.add_argument("--kubeconfig", help="kubeconfig for the target cluster")
    vf.add_argument("--env-file", action="append", default=[], metavar="PATH",
                    help="DFE_* env file the deploy used (repeatable; later wins). Without it the suite uses its default namespaces and fails a healthy stack.")
    vf.add_argument("--mode", choices=MODES, help="deploy profile, so the suite knows whether a broker is expected")
    vf.add_argument("--from-terraform", metavar="TF_DIR",
                    help="read DFE_* outputs from this terraform environment, as the deploy did (supplies DFE_NAMESPACE)")
    vf.set_defaults(func=cmd_verify)

    # refresh
    rf = sub.add_parser(
        "refresh",
        help="land the tracked git ref on a persistent deploy now, then re-prove it",
        description="Upgrade-in-place for a persistent deploy: hard-refresh every Argo "
                    "Application so a pushed commit lands now instead of at the next "
                    "poll, wait for every Application on a tracked repo to report "
                    "Synced and Healthy, then run the readiness gate and the same "
                    "smoke suite `verify` runs. Deploys nothing -- Argo already "
                    "tracks the ref. The smoke stage needs the app namespace, so "
                    "without --env-file or --namespace it refuses unless --skip-verify.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    rf.add_argument("--kubeconfig", default=os.environ.get("KUBECONFIG"),
                    help="kubeconfig for the target cluster (default: $KUBECONFIG / current context)")
    rf.add_argument("--env-file", action="append", default=[], metavar="PATH",
                    help="DFE_* env file the deploy used (repeatable; later wins) -- supplies DFE_NAMESPACE")
    rf.add_argument("--from-terraform", default=None, metavar="TF_DIR",
                    help="read DFE_* outputs from a terraform env dir, as the deploy did (env files win over it)")
    rf.add_argument("--mode", choices=MODES,
                    help="deploy profile, so the smoke suite knows whether a broker is expected")
    rf.add_argument("--namespace", default=None,
                    help="app namespace the readiness gate asserts workloads in (default: DFE_NAMESPACE from --env-file)")
    rf.add_argument("--argocd-namespace", default="argocd",
                    help="namespace holding the Argo Applications to hard-refresh")
    rf.add_argument("--readiness-timeout", type=int, default=600,
                    help="bounded wait in seconds, applied to the Argo sync and again to the readiness gate (sets READINESS_TIMEOUT)")
    rf.add_argument("--skip-verify", action="store_true",
                    help="stop after the readiness gate (the run then proves Ready, not working)")
    # cmd_verify runs on this same namespace, so the flag it reads must exist here.
    rf.set_defaults(func=cmd_refresh, readiness_only=False)

    ac = sub.add_parser(
        "acceptance",
        help="run the live pytest acceptance suite over supervised port-forwards",
        description="Distinct from `verify`, which wraps the bootstrap smoke tests. "
                    "This carries the engine repository's pytest suite against a "
                    "deployed stack.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    ac.add_argument("--env-file", action="append", default=[], metavar="PATH",
                    help="DFE_* env file (repeatable; later wins) -- the ONLY place estate-specific values live")
    ac.add_argument("--kubeconfig", default=os.environ.get("KUBECONFIG"), help="kubeconfig for the target cluster")
    ac.add_argument("--context", default=None, help="kubeconfig context (default: DFE_KUBE_CONTEXT from --env-file)")
    ac.add_argument("--namespace", default=None, help="namespace the apps run in (default: DFE_NAMESPACE, else dfe-local)")
    ac.add_argument("--ch-namespace", default=None, help="namespace the datastore runs in (default: DFE_CH_NAMESPACE, else clickhouse)")
    ac.add_argument("--ch-secret", default=None, help="secret holding the datastore password (default: DFE_CH_SECRET)")
    ac.add_argument("--server", default=None,
                    help="API address, for a kubeconfig whose server name does not resolve here (default: DFE_KUBE_SERVER)")
    ac.add_argument("--receiver-target", default="svc/dfe-receiver", help="port-forward target for ingest")
    ac.add_argument("--ch-target", default="svc/dfe-clickhouse", help="port-forward target for the datastore")
    ac.add_argument("--engine-target", default="svc/dfe-engine", help="port-forward target for the engine API")
    ac.add_argument("--receiver-port", type=int, default=18080, help="local port for ingest")
    ac.add_argument("--ch-port", type=int, default=18123, help="local port for the datastore")
    ac.add_argument("--engine-port", type=int, default=18000, help="local port for the engine API")
    ac.add_argument("--ch-user", default="default", help="datastore user the suite connects as")
    ac.add_argument("--ch-database", default="dfe", help="datastore database the assertions read")
    ac.add_argument("--repo", default="/projects/dfe-engine", help="engine checkout the suite runs from")
    ac.add_argument("pytest_args", nargs=argparse.REMAINDER,
                    help="arguments passed through to pytest (default: the live filebeat suite)")
    ac.set_defaults(func=cmd_acceptance)

    ui = sub.add_parser(
        "ui",
        help="run the dfe-ui Playwright acceptance specs against a deployed stack",
        description="Beside `acceptance`, which proves the data path. This rotates the "
                    "break-glass password, then drives the UI with the dfe-ui suite's "
                    "acceptance-tagged specs.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    ui.add_argument("--env-file", action="append", default=[], metavar="PATH",
                    help="DFE_* env file (repeatable; later wins) -- the ONLY place estate-specific values live")
    ui.add_argument("--kubeconfig", default=os.environ.get("KUBECONFIG"), help="kubeconfig for the target cluster")
    ui.add_argument("--context", default=None, help="kubeconfig context (default: DFE_KUBE_CONTEXT from --env-file)")
    ui.add_argument("--namespace", default=None, help="namespace the apps run in (default: DFE_NAMESPACE, else dfe-local)")
    ui.add_argument("--server", default=None,
                    help="API address, for a kubeconfig whose server name does not resolve here (default: DFE_KUBE_SERVER)")
    ui.add_argument("--ui-url", default=None, help="the gateway URL the UI is served on (omit to port-forward, with a warning)")
    ui.add_argument("--ui-target", default="svc/dfe-ui", help="port-forward target for the UI when --ui-url is not given")
    ui.add_argument("--engine-target", default="svc/dfe-engine", help="port-forward target for the engine API")
    ui.add_argument("--ui-port", type=int, default=13000, help="local port for the UI forward")
    ui.add_argument("--engine-port", type=int, default=18000, help="local port for the engine API")
    ui.add_argument("--ui-repo", default="/projects/dfe-ui", help="dfe-ui checkout the suite runs from")
    ui.add_argument("--grep", default="@acceptance", help="Playwright --grep selecting the acceptance-tier specs")
    ui.add_argument("--no-rotate", action="store_true", help="skip the break-glass rotation (the run then proves less)")
    ui.add_argument("playwright_args", nargs=argparse.REMAINDER,
                    help="arguments passed through to playwright test")
    ui.set_defaults(func=cmd_ui)

    # pin -- resolve a version's registry digest and (with --write) set the
    # current stack's digests: in versions.yaml. Registered from resolve_pins.
    add_pin_subparser(sub)

    return ap


def main(argv: list[str] | None = None) -> int:
    ap = build_parser()
    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as exc:
        stderr = (exc.stderr or b"").decode("utf-8", "replace").strip()
        print(f"command failed: {' '.join(exc.cmd)}\n{stderr}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
