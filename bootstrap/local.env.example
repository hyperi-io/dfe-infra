# Manual bootstrap without Terraform. Copy to .env and fill values.
# Prefer using bridge.py with Terraform outputs instead.
#
# This file IS the deployment's env contract: everything estate-specific
# (addresses, domains, credentials) lives in the copied, GITIGNORED .env --
# distribute it to teammates out-of-band (e.g. a Bitwarden secure note), never
# through git. One filled .env is everything `dfe-ops preflight` / `cycle` /
# `stack-deploy` need on top of a kubeconfig: clone, drop in .env, go.
# The full loop is documented in docs/TESTING-CYCLE.md.
#
# EVERY value here is an EXAMPLE, and deliberately not a real one. This file is
# COMMITTED in a repo that ships publicly, so it must never carry a real domain,
# host, cluster address or credential -- put those in the copied .env, which is
# gitignored. Domains use RFC 2606 (example.com) and addresses RFC 5737
# (192.0.2.0/24), both reserved for documentation, so nothing here can resolve
# to anyone's estate. The in-cluster *.svc.cluster.local names are generic
# Kubernetes service DNS and identify nothing.

DFE_ENV="local"
DFE_CLOUD="local"
DFE_REGION="local"
DFE_DOMAIN="dfe.example.com"
DFE_PROFILE="slim"
DFE_REPO_URL="https://github.com/your-org/dfe-infra"
DFE_TARGET_REVISION="main"
DFE_STORAGE_CLASS="local-path"
DFE_NAMESPACE="dfe-local"
DFE_CLICKHOUSE_HOST="clickhouse.clickhouse.svc.cluster.local"
DFE_KAFKA_BOOTSTRAP="dfe-kafka-kafka-bootstrap.strimzi.svc.cluster.local:9092"
DFE_OTEL_ENDPOINT="otel-collector-gateway.otel.svc.cluster.local:4317"
DFE_VAULT_ADDR="https://bao.dfe.example.com:8200"
DFE_VAULT_ROLE_ID=""
DFE_WORKLOAD_IDENTITY_ANNOTATIONS="{}"
DFE_REGISTRY_HOST=""
DFE_REGISTRY_USER=""
DFE_REGISTRY_TOKEN=""

# Power-on self test run at the end of bootstrap.sh: full | readiness | off.
# 'full' is the default and what a production deploy should run.
DFE_POST="full"

# scripts/validate-charts.sh -- renders every chart with the real overlays and,
# when a context is given, validates the result against that cluster's API
# server (server-side dry-run: no changes are made). Holds NO credentials: the
# kubeconfig lives outside the repo and this is only the context NAME. Leave
# DFE_KUBE_CONTEXT empty to run render-only, which needs no cluster at all.
#
# Addresses below are RFC 5737 documentation IPs -- placeholders, not anyone's
# real estate. Put your own in the copied .env, which is gitignored; this file
# is committed, so real cluster IPs and hostnames must never land in it.
#
#   # point at your DFE cluster's context, then dry-run every chart against it
#   DFE_KUBE_CONTEXT="my-dfe"
#
#   # fetch that cluster's kubeconfig from one of its nodes
#   python3 scripts/dfe-ops kubeconfig --node 192.0.2.10 --out .tmp/dfe.kubeconfig
#
# WATCH OUT if your estate runs more than one cluster: point this at the one
# that carries the workload node label your profile selects on
# (dfe.hyperi.io/workload by default). Aim it at a neighbouring cluster without
# that label and every DFE pod sits Pending forever, looking like a chart fault
# when it is only the wrong target.
DFE_KUBE_CONTEXT=""
DFE_VALIDATE_VALUES="argocd/values/common.yaml argocd/values/local.yaml"
DFE_VALIDATE_NS="dfe-local"
