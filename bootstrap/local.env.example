# Manual bootstrap without Terraform. Copy to .env and fill values.
# Prefer using bridge.py with Terraform outputs instead.

DFE_ENV="local"
DFE_CLOUD="local"
DFE_REGION="local"
DFE_DOMAIN="devex.hyperi.io"
DFE_PROFILE="slim"
DFE_REPO_URL="https://github.com/catinspace-au/dfe-infra"
DFE_TARGET_REVISION="main"
DFE_STORAGE_CLASS="local-path"
DFE_NAMESPACE="dfe-local"
DFE_CLICKHOUSE_HOST="clickhouse.clickhouse.svc.cluster.local"
DFE_KAFKA_BOOTSTRAP="dfe-kafka-kafka-bootstrap.strimzi.svc.cluster.local:9092"
DFE_OTEL_ENDPOINT="otel-collector-gateway.otel.svc.cluster.local:4317"
DFE_VAULT_ADDR="https://bao.devex.hyperi.io:8200"
DFE_VAULT_ROLE_ID=""
DFE_WORKLOAD_IDENTITY_ANNOTATIONS="{}"
DFE_REGISTRY_HOST=""
DFE_REGISTRY_USER=""
DFE_REGISTRY_TOKEN=""

# Power-on self test run at the end of bootstrap.sh: full | readiness | off.
# 'full' is the default and what a production deploy should run.
DFE_POST="full"

# scripts/validate-charts.sh -- renders every chart with the real overlays and,
# when a context is given, validates the result against that cluster's API
# server (server-side dry-run: no changes are made). Holds NO credentials: the
# kubeconfig lives outside the repo and this is only the context NAME. Leave
# DFE_KUBE_CONTEXT empty to run render-only, which needs no cluster at all.
DFE_KUBE_CONTEXT=""
DFE_VALIDATE_VALUES="argocd/values/common.yaml argocd/values/local.yaml"
DFE_VALIDATE_NS="dfe-local"
