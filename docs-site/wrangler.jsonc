// Project:      dfe-infra
// File:         docs-site/wrangler.jsonc
// Purpose:      The assets-only Cloudflare Worker that serves the DFE docs site.
// Language:     JSONC
//
// License:      BUSL-1.1
// Copyright:    (c) 2026 HYPERI PTY LIMITED
//
// No `main`: with no Worker script, every request is a static asset request.
// The account comes from CLOUDFLARE_ACCOUNT_ID, never from this file.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dfe-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "dfe.docs.hyperi.io",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
