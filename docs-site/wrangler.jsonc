// Project:      dfe-infra
// File:         docs-site/wrangler.jsonc
// Purpose:      The assets-only Cloudflare Worker that serves the DFE docs site.
// Language:     JSONC
//
// License:      BUSL-1.1
// Copyright:    (c) 2026 HYPERI PTY LIMITED
//
// No `main`: with no Worker script, every request is a static asset request.
// The account comes from CLOUDFLARE_ACCOUNT_ID, never from this file.
// The Worker, its custom domain and DNS are OpenTofu's in hyperi-infra, so no
// routes here: a deploy that lists routes replaces the domain set tofu owns.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dfe-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // With no routes, wrangler turns workers.dev on unless this says otherwise.
  "workers_dev": false,
  "preview_urls": false
}
